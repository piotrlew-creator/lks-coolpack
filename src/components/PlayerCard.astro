---
/*
  Kafel zawodnika w siatce składu. Kliknięcie uruchamia efekt pioruna
  (skrypt w src/scripts/site.ts), a zdjęcie i numer „przelatują”
  na stronę zawodnika.
*/
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { type Lang, playerUrl, pozycja, t } from "../i18n/ui";
import Silhouette from "./Silhouette.astro";

interface Props {
  p: CollectionEntry<"zawodnicy">;
  lang: Lang;
  index?: number;
}
const { p, lang, index = 0 } = Astro.props;
const d = p.data;
---

<a
  class="pcard reveal"
  href={playerUrl(p.id, lang)}
  data-bolt
  data-slug={p.id}
  data-pos={d.pozycja}
  style={`--d:${Math.min(index, 8) * 60}ms`}
>
  <span class="pcard__num" aria-hidden="true" data-vt="number">{d.numer}</span>
  <span class="pcard__stripe" aria-hidden="true"></span>
  <span class="pcard__photo" data-vt="photo">
    {
      d.zdjecie ? (
        <Image
          src={d.zdjecie}
          alt=""
          widths={[280, 420, 560]}
          sizes="(min-width: 1100px) 280px, (min-width: 700px) 30vw, 46vw"
          loading="lazy"
        />
      ) : (
        <Silhouette />
      )
    }
  </span>
  <span class="pcard__info">
    <span class="pcard__meta">
      <span class="pcard__badge">#{d.numer}</span>
      {pozycja(d.pozycja, lang)}
      {d.kapitan && <span class="pcard__cap" title={t(lang, "team.captain")}>C</span>}
    </span>
    <span class="pcard__first">{d.imie}</span>
    <span class="pcard__last">{d.nazwisko}</span>
  </span>
  <span class="pcard__glare" aria-hidden="true"></span>
</a>

<style>
  .pcard {
    --tx: 0deg;
    --ty: 0deg;
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    text-decoration: none;
    background:
      radial-gradient(120% 80% at 50% 0%, #3a2f28 0%, transparent 60%),
      linear-gradient(160deg, #2a231e 0%, #120f0c 100%);
    transform: perspective(900px) rotateX(var(--tx)) rotateY(var(--ty));
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05) inset;
    -webkit-tap-highlight-color: transparent;
  }
  .pcard:hover {
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45), 0 0 0 2px var(--red);
  }
  .pcard:focus-visible {
    outline-offset: 4px;
  }

  .pcard__num {
    position: absolute;
    z-index: -1;
    right: -4%;
    top: -2%;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(120px, 22vw, 230px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.14);
    transition:
      color 300ms,
      -webkit-text-stroke-color 300ms,
      transform 400ms var(--ease);
  }
  .pcard:hover .pcard__num {
    color: var(--red);
    -webkit-text-stroke-color: var(--red);
    transform: translate(-4%, 4%) scale(1.04);
  }

  .pcard__stripe {
    position: absolute;
    z-index: -1;
    left: -30%;
    bottom: 18%;
    width: 160%;
    height: 22%;
    background: var(--red);
    transform: rotate(-14deg) scaleX(0.25);
    transform-origin: left center;
    opacity: 0.0;
    transition: transform 420ms var(--ease), opacity 300ms;
  }
  .pcard:hover .pcard__stripe {
    transform: rotate(-14deg) scaleX(1);
    opacity: 0.9;
  }

  .pcard__photo {
    position: absolute;
    inset: 8% 4% 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    color: #fff;
    transition: transform 400ms var(--ease);
    transform-origin: 50% 100%;
  }
  .pcard__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .pcard:hover .pcard__photo {
    transform: scale(1.05);
  }

  .pcard__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 56px 14px 14px;
    background: linear-gradient(to top, rgba(10, 8, 6, 0.95) 0%, rgba(10, 8, 6, 0.75) 45%, transparent 100%);
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .pcard__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d8cfc5;
    margin-bottom: 8px;
  }
  .pcard__badge {
    background: var(--red);
    color: #fff;
    padding: 4px 7px 3px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 14px;
  }
  .pcard__cap {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 12px;
  }
  .pcard__first {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(16px, 2vw, 20px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pcard__last {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(24px, 3.2vw, 34px);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .pcard__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.18), transparent 45%);
    opacity: 0;
    transition: opacity 300ms;
  }
  .pcard:hover .pcard__glare {
    opacity: 1;
  }

  /* Kliknięty kafel — chwila „uderzenia” przed przejściem */
  :global(.pcard.is-struck) {
    animation: struck 380ms steps(1, end) both;
  }
  :global(.pcard.is-struck) .pcard__num {
    color: #fff;
    -webkit-text-stroke-color: #fff;
  }
  @keyframes struck {
    0% {
      transform: translate(0, 0);
      filter: brightness(2.2) contrast(1.3);
    }
    15% {
      transform: translate(-5px, 3px) rotate(-0.6deg);
      filter: brightness(1);
    }
    30% {
      transform: translate(4px, -3px) rotate(0.5deg);
      filter: brightness(1.8);
    }
    45% {
      transform: translate(-3px, 2px);
      filter: brightness(1);
    }
    60% {
      transform: translate(2px, -1px);
    }
    75% {
      transform: none;
    }
  }
</style>
