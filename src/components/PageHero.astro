---
/* Nagłówek podstrony: jasny pas z tytułem (jak na stronie głównej). */
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<section class="phero">
  <div class="wrap phero__in">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class="h-xl">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
    color: var(--text);
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + clamp(32px, 6vw, 72px)) 0 clamp(28px, 4vw, 48px);
  }
  .phero h1 {
    margin-bottom: 18px;
  }
  .phero .lead {
    color: var(--muted);
    margin: 0;
  }
  /* Telefon poziomo (niski ekran): niższy pas, żeby treść była od razu widać */
  @media (orientation: landscape) and (max-height: 500px) {
    .phero {
      padding: calc(var(--header-h) + 16px) 0 20px;
    }
    .phero .kicker {
      margin-bottom: 6px;
    }
    .phero h1 {
      font-size: 44px;
      margin-bottom: 8px;
    }
    .phero .lead {
      font-size: 16px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes phero-in {
    from { opacity: 0; transform: translateY(26px); }
  }
</style>
