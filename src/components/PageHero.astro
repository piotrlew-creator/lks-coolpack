---
/* Nagłówek podstrony: ciemny pas z tytułem. */
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<section class="phero">
  <div class="wrap phero__in">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class="h-xl">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(70% 90% at 85% 0%, #3b0a0e 0%, transparent 60%),
      linear-gradient(180deg, #120f0c 0%, #0b0907 100%);
    color: #fff;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + clamp(32px, 6vw, 72px)) 0 clamp(28px, 4vw, 48px);
  }
  .phero .kicker {
    color: var(--red-on-dark);
  }
  .phero h1 {
    margin-bottom: 18px;
  }
  .phero .lead {
    color: #cfc6bc;
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    @keyframes phero-in {
    from { opacity: 0; transform: translateY(26px); }
  }
</style>
