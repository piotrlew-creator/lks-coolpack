---
/*
  Kafel członka sztabu na stronie startowej — wygląd jak kafel zawodnika,
  bez efektu pioruna i bez numeru. Kliknięcie prowadzi na podstronę Sztab (do tej osoby).
*/
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { type Lang, route } from "../i18n/ui";
import { pick } from "../lib/data";
import Silhouette from "./Silhouette.astro";

interface Props {
  s: CollectionEntry<"sztab">;
  lang: Lang;
  index?: number;
}
const { s, lang, index = 0 } = Astro.props;
const d = s.data;
const funkcja = pick(d.funkcja, d.funkcjaEn, lang);
---

<a class="stcard reveal" href={`${route("sztab", lang)}#${s.id.replace(/^\d+-/, "")}`} style={`--d:${Math.min(index, 8) * 60}ms`}>
  <span class="stcard__photo">
    {
      d.zdjecie ? (
        <Image src={d.zdjecie} alt={`${d.imie} ${d.nazwisko}`} widths={[300, 450, 600]} sizes="(min-width: 1100px) 280px, (min-width: 700px) 30vw, 62vw" loading="lazy" />
      ) : (
        <Silhouette />
      )
    }
  </span>
  <span class="stcard__info">
    <span class="stcard__role">{funkcja}</span>
    <span class="stcard__first">{d.imie}</span>
    <span class="stcard__last">{d.nazwisko}</span>
  </span>
</a>

<style>
  .stcard {
    container-type: inline-size;
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    text-decoration: none;
    transition: box-shadow 250ms var(--ease);
    background:
      radial-gradient(120% 80% at 50% 0%, #3a2f28 0%, transparent 60%),
      linear-gradient(160deg, #2a231e 0%, #120f0c 100%);
  }
  .stcard:hover,
  .stcard:focus-visible {
    box-shadow: 0 0 0 2px var(--red);
  }
  .stcard:focus-visible {
    outline-offset: 4px;
  }
  .stcard__photo {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .stcard__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .stcard__photo :global(.silhouette) {
    width: 90%;
    height: 90%;
  }
  .stcard__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 56px 14px 14px;
    background: linear-gradient(to top, rgba(10, 8, 6, 0.95) 0%, rgba(10, 8, 6, 0.75) 45%, transparent 100%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }
  .stcard__role {
    max-width: 100%;
    margin-bottom: 8px;
    padding: 4px 7px 3px;
    border-radius: 6px;
    background: var(--red);
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: min(13px, 6.2cqi);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .stcard__first {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: min(20px, 9cqi);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .stcard__last {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: min(34px, 13.5cqi);
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
