---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import herbBialy from "../assets/logo/herb-bialy.png";
import { klub } from "../data/klub";
import { type Lang, NAV, route, t } from "../i18n/ui";
import { telHref } from "../lib/url";
import { skalaLogo } from "../lib/data";
import Social from "./Social.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sponsorzy = (await getCollection("sponsorzy"))
  .sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const biuro = klub.kontakt.biuro;
const rok = new Date().getFullYear();
import LeagueLogos from "./LeagueLogos.astro";
---

<footer class="ftr">
  <div class="ftr__bolt" aria-hidden="true"></div>
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <Image class="ftr__crest" src={herbBialy} alt={klub.nazwa} width={120} height={120} />
      <div class="ftr__id">
        <p class="ftr__name"><span>{klub.nazwa.split(" ")[0]}</span> <span class="ftr__name2">{klub.nazwa.split(" ").slice(1).join(" ")}</span></p>
        <p class="ftr__since">{lang === "pl" ? `ŁKS od ${klub.rokZalozenia} roku` : `ŁKS since ${klub.rokZalozenia}`}</p>
      </div>
      <div class="ftr__social"><Social lang={lang} /></div>
    </div>

    <nav aria-label={t(lang, "nav.menu")}>
      <ul class="ftr__links">
        {NAV.map((k) => <li><a href={route(k, lang)}>{t(lang, `nav.${k}`)}</a></li>)}
      </ul>
    </nav>

    <div class="ftr__contact">
      <p class="ftr__h">{t(lang, "contact.office")}</p>
      {biuro.adres && <p>{biuro.adres}</p>}
      <p class="ftr__lines">
        {biuro.telefon && <a href={telHref(biuro.telefon)}>{t(lang, "contact.tel")} {biuro.telefon}</a>}
        {biuro.email && <a href={`mailto:${biuro.email}`}>{biuro.email}</a>}
      </p>
      {!biuro.adres && !biuro.telefon && !biuro.email && <p class="ftr__muted">{t(lang, "contact.tbd")}</p>}
    </div>
  </div>

  {
    sponsorzy.length > 0 && (
      <div class="wrap ftr__sponsors">
        <p class="ftr__h">{t(lang, "sponsors.strip")}</p>
        <ul>
          {sponsorzy.map((s) => (
            <li>
              {s.data.link ? (
                <a href={s.data.link} target="_blank" rel="noopener" aria-label={s.data.nazwa}>
                  {s.data.logoMono || s.data.logo ? (
                    <Image src={(s.data.logoMono ?? s.data.logo)!} alt={s.data.nazwa} height={Math.round(36 * skalaLogo((s.data.logoMono ?? s.data.logo)!))} style={`--k:${skalaLogo((s.data.logoMono ?? s.data.logo)!)}`} />
                  ) : (
                    <span class="ftr__spname">{s.data.nazwa}</span>
                  )}
                </a>
              ) : s.data.logoMono || s.data.logo ? (
                <Image src={(s.data.logoMono ?? s.data.logo)!} alt={s.data.nazwa} height={Math.round(36 * skalaLogo((s.data.logoMono ?? s.data.logo)!))} style={`--k:${skalaLogo((s.data.logoMono ?? s.data.logo)!)}`} />
              ) : (
                <span class="ftr__spname">{s.data.nazwa}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="wrap ftr__league">
    <p class="ftr__h">{t(lang, "league.label")}</p>
    <LeagueLogos height={48} dark />
  </div>

  <div class="wrap ftr__bottom">
    <p>© {rok} {klub.nazwa}. {t(lang, "footer.rights")}</p>
    <a href={route("prywatnosc", lang)}>{t(lang, "nav.prywatnosc")}</a>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    background: var(--black-deep);
    color: #c9c0b6;
    padding-top: clamp(40px, 6vw, 64px);
    overflow: hidden;
    font-size: 16px;
  }
  .ftr__bolt {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--red);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 62% 100%, 60% 0, 57% 100%, 0 100%);
  }
  .ftr a {
    color: #f4f0ea;
    text-decoration: none;
  }
  .ftr a:hover {
    color: var(--red-on-dark);
  }
  .ftr__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .ftr__grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }
  .ftr__brand {
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: start;
    align-items: center;
    column-gap: 16px;
  }
  .ftr__crest {
    width: 84px;
    height: 84px;
  }
  .ftr__social {
    grid-column: 1 / -1;
    margin-top: 16px;
  }
  .ftr__name {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 28px;
    text-transform: uppercase;
    color: #fff;
    margin: 0;
    line-height: 1;
  }
  /* nazwa zawsze w 2 wierszach: „ŁKS” / „CoolPack Łódź”; druga linia dopasowuje się do szerokości */
  .ftr__id {
    container-type: inline-size;
    min-width: 0;
  }
  .ftr__name {
    font-size: min(28px, 14.5cqi);
  }
  .ftr__name span {
    display: block;
  }
  .ftr__name2,
  .ftr__since {
    white-space: nowrap;
  }
  .ftr__since {
    margin: 4px 0 0;
    color: var(--red-on-dark);
    font-family: var(--font-cond);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 14px;
  }
  .ftr__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .ftr__links a {
    display: inline-block;
    padding: 8px 0;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ftr__h {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8f857b;
    margin: 0 0 10px;
  }
  .ftr__contact p {
    margin: 0 0 4px;
  }
  .ftr__lines {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* pole dotyku 44 px */
  .ftr__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .ftr__muted {
    color: #8f857b;
  }
  .ftr__sponsors {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ftr__sponsors ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 28px 40px;
    align-items: center;
  }
  /* monitor: wszystkie logotypy w jednym rzędzie, równo rozłożone */
  @media (min-width: 1024px) {
    .ftr__sponsors ul {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 24px;
    }
    .ftr__sponsors :global(img) {
      max-width: 100%;
    }
  }
  .ftr__sponsors :global(img) {
    height: calc(32px * var(--k, 1));
    width: auto;
    opacity: 0.85;
    transition: opacity 160ms;
  }
  .ftr__sponsors a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .ftr__spname {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.85;
  }
  .ftr__sponsors a:hover :global(img) {
    opacity: 1;
  }
  .ftr__league {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  /* telefon: oba logotypy rozgrywek w jednym wierszu — zmniejszają się do szerokości ekranu */
  @media (max-width: 759px) {
    .ftr__league :global(.liga) {
      --h: min(48px, calc((100vw - 56px) / 6.2));
      flex-wrap: nowrap;
      gap: 18px;
    }
    .ftr__league :global(.liga li:first-child img) {
      height: calc(var(--h) * 1.5) !important;
    }
    .ftr__league :global(.liga li:last-child img) {
      height: var(--h) !important;
    }
  }
  .ftr__bottom {
    margin-top: 40px;
    padding-block: 20px calc(20px + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 14px;
    color: #8f857b;
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 24px;
  }
  .ftr__bottom p {
    margin: 0;
  }
  .ftr__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #c9c0b6;
  }

  /* -- Telefon: zwarta stopka ---------------------------------- */
  /* wąski telefon: ikony Facebook / Instagram / X w osobnym wierszu pod nazwą klubu */
  @media (max-width: 479px) {
    .ftr .ftr__brand {
      grid-template-columns: auto 1fr;
    }
    .ftr .ftr__social {
      grid-column: 1 / -1;
      margin-top: 14px;
    }
  }
  @media (max-width: 759px) {
    .ftr {
      padding-top: 28px;
      font-size: 15px;
    }
    .ftr__grid {
      gap: 22px;
    }
    .ftr__brand {
      grid-template-columns: auto 1fr auto;
      column-gap: 12px;
    }
    .ftr__crest {
      width: 52px;
      height: 52px;
      grid-row: auto;
    }
    .ftr__name {
      font-size: min(22px, 14.5cqi);
    }
    .ftr__since {
      font-size: 12px;
    }
    .ftr__social {
      grid-column: auto;
      margin-top: 0;
    }
    .ftr__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
      gap: 0 16px;
    }
    .ftr__links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0;
      font-size: 16px;
    }
    .ftr__h {
      margin-bottom: 4px;
      font-size: 12px;
    }
    .ftr__lines {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: 18px;
    }
    .ftr__sponsors {
      margin-top: 18px;
      padding-top: 16px;
    }
    .ftr__sponsors ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4px 16px;
    }
    .ftr__sponsors li {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
    }
    .ftr__sponsors :global(img) {
      height: auto;
      max-height: calc(24px * var(--k, 1));
      max-width: 100%;
    }
    .ftr__spname {
      font-size: 15px;
    }
    .ftr__bottom {
      margin-top: 18px;
      padding-block: 6px calc(10px + env(safe-area-inset-bottom));
      font-size: 13px;
    }
  }
</style>
