---
/*
  Karta meczu (strona startowa i wpisy w Aktualnościach).
  data-koniec: 3 godziny po rozpoczęciu karta sama się chowa
  (skrypt w src/scripts/site.ts), a pojawia się element z data-po-meczu.
*/
import { Image } from "astro:assets";
import { klub } from "../data/klub";
import { type Lang, t } from "../i18n/ui";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
  data: string; // "2026-11-19T18:00" czas polski
  rywal: string;
  dom: boolean;
  miejsce?: string;
  bilety?: string;
  transmisja?: string;
  ics?: string; // id meczu → plik kalendarza
  mapa?: string; // mapa dojazdu do hali
  kicker?: string;
  zapowiedz?: string; // link do wpisu o tym meczu (na stronie startowej)
  terminarz?: string; // link do strony Terminarz i wyniki (na stronie startowej)
  plakat?: ImageMetadata; // grafika meczowa (pole „zdjecie” we wpisie o tym meczu)
}
const { lang, data, rywal, dom, miejsce, bilety, transmisja, ics, mapa, kicker, zapowiedz, terminarz, plakat } = Astro.props;
const icsUrl = ics ? u(lang === "pl" ? `kalendarz/${ics}.ics` : `en/calendar/${ics}.ics`) : undefined;

// Czas polski → UTC (zimą +1, latem +2) liczony w czasie budowania
function polishToDate(local: string): Date {
  const guess = new Date(local + "Z");
  const pl = new Date(guess.toLocaleString("en-US", { timeZone: "Europe/Warsaw" }));
  const utc = new Date(guess.toLocaleString("en-US", { timeZone: "UTC" }));
  return new Date(guess.getTime() - (pl.getTime() - utc.getTime()));
}
const start = polishToDate(data);
const koniec = start.getTime() + 3 * 3600 * 1000;
const loc = lang === "pl" ? "pl-PL" : "en-GB";
const dzien = new Intl.DateTimeFormat(loc, { weekday: "long", day: "numeric", month: "long", timeZone: "Europe/Warsaw" }).format(start);
// „T00:00” = godzina jeszcze nieznana (tak zapisuje ją terminarz)
const bezGodziny = data.endsWith("T00:00");
const godz = new Intl.DateTimeFormat("pl-PL", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Warsaw" }).format(start);
const gospodarz = dom ? klub.nazwaKrotka : rywal;
const gosc = dom ? rywal : klub.nazwaKrotka;
---

<div class:list={["mcard", { "mcard--plakat": plakat }]} data-koniec={koniec} data-start={start.getTime()}>
  {plakat && (
    <figure class="mcard__plakat">
      <Image src={plakat} alt={`${t(lang, "match.poster")}: ${gospodarz} – ${gosc}`} widths={[400, 640, 900]} sizes="(min-width: 760px) 320px, 92vw" />
    </figure>
  )}
  <div class="mcard__body">
  <p class="kicker mcard__kicker">{kicker ?? t(lang, "match.kicker")}</p>
  <p class="mcard__when">
    <span class="mcard__day">{dzien}</span>
    {!bezGodziny && <span class="mcard__time">{godz}</span>}
  </p>
  <p class="mcard__teams">
    <span class:list={[{ "mcard__us": dom }]}>{gospodarz}</span>
    <span class="mcard__vs">–</span>
    <span class:list={[{ "mcard__us": !dom }]}>{gosc}</span>
  </p>
  <p class="mcard__meta">
    <span class:list={["mcard__tag", { "mcard__tag--home": dom }]}>{t(lang, dom ? "match.home" : "match.away")}</span>
    {miejsce && (mapa ? <a class="mcard__map" href={mapa} target="_blank" rel="noopener">{miejsce}</a> : <span>{miejsce}</span>)}
    <span class="mcard__count" data-odliczanie hidden></span>
  </p>
  {
    bilety && (
      <div class="mcard__tix">
        <a class="btn mcard__tixbtn" href={bilety} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2.2a2.8 2.8 0 0 0 0 5.6V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.2a2.8 2.8 0 0 0 0-5.6V7Zm11 0.5v2h1.6v-2H14Zm0 3.5v2h1.6v-2H14Zm0 3.5v2h1.6v-2H14Z"/></svg>
          {t(lang, "match.buy")}
        </a>
        <p class="mcard__tixnote">{t(lang, "match.buyNote")}</p>
      </div>
    )
  }
  {
    (transmisja || zapowiedz || terminarz || icsUrl) && (
      <div class="btn-row btn-row--equal mcard__btns">
        {zapowiedz && <a class="btn mcard__more" href={zapowiedz}>{t(lang, "match.preview")}</a>}
        {terminarz && <a class="btn btn--ghost" href={terminarz}>{t(lang, "match.none.cta")}</a>}
        {transmisja && <a class="btn btn--ghost" href={transmisja} target="_blank" rel="noopener">{t(lang, "match.stream")}</a>}
        {icsUrl && (
          <a class="btn btn--ghost mcard__cal" href={icsUrl}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm12 8H5v9h14v-9ZM5 6v2h14V6H5Zm6 5h2v2.5h2.5v2H13V18h-2v-2.5H8.5v-2H11V11Z"/></svg>
            {t(lang, "match.calendar")}
          </a>
        )}
      </div>
    )
  }
  {transmisja && <p class="mcard__tv">{t(lang, "match.streamNote")}</p>}
  </div>
</div>

<style>
  /* Bilety: najważniejszy przycisk w karcie meczu domowego */
  .mcard__tix {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }
  .mcard__tixbtn {
    gap: 12px;
    min-height: 60px;
    padding-inline: 32px;
    font-size: 21px;
    box-shadow: 0 8px 22px -10px rgb(212 4 20 / 0.6);
  }
  .mcard__tixbtn svg {
    width: 26px;
    height: 26px;
    flex: none;
  }
  .mcard__tixnote {
    margin: 0;
    font-weight: 700;
    color: var(--red);
  }
  @media (max-width: 640px) {
    .mcard__tixbtn {
      width: 100%;
    }
  }
  /* Grafika meczowa: na telefonie nad treścią, na większym ekranie po prawej */
  .mcard--plakat {
    display: grid;
    gap: 18px;
  }
  .mcard__plakat {
    margin: 0;
  }
  .mcard__plakat img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 4px);
  }
  .mcard__body {
    min-width: 0;
  }
  @media (min-width: 760px) {
    .mcard--plakat {
      grid-template-columns: minmax(0, 1fr) clamp(240px, 30%, 340px);
      align-items: center;
      column-gap: clamp(20px, 3vw, 40px);
    }
    .mcard__plakat {
      grid-column: 2;
      grid-row: 1;
    }
    .mcard__body {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .mcard__map {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  .mcard__map:hover {
    color: var(--red);
  }
  .mcard__cal {
    gap: 8px;
  }
  .mcard__tv {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  /* Jasna, prosta karta: data i godzina, drużyny, miejsce, odliczanie */
  .mcard {
    background: var(--bg-2);
    color: var(--text);
    border: 1px solid var(--border);
    border-left: 5px solid var(--red);
    border-radius: var(--radius);
    padding: clamp(20px, 3vw, 30px);
  }
  .mcard__kicker {
    margin-bottom: 10px;
  }
  .mcard p {
    margin: 0;
  }
  .mcard__when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-family: var(--font-cond);
    text-transform: uppercase;
  }
  .mcard__day {
    font-weight: 700;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
  }
  .mcard__time {
    font-weight: 800;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1;
  }
  .mcard__teams {
    margin-top: 10px !important;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(24px, 3.2vw, 34px);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .mcard__us {
    color: var(--red);
  }
  .mcard__vs {
    margin-inline: 6px;
    color: var(--muted);
  }
  .mcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 12px !important;
    font-size: 16px;
    color: var(--muted);
  }
  .mcard__tag {
    padding: 3px 10px;
    border-radius: 999px;
    border: 1.5px solid var(--text);
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }
  .mcard__tag--home {
    background: var(--text);
    color: var(--bg);
  }
  .mcard__count {
    font-weight: 600;
    color: var(--red);
  }
  .mcard__btns {
    margin-top: 20px;
  }
</style>
