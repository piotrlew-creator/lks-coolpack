---
/*
  Interaktywne zdjęcie drużyny na stronie startowej.
  Najechanie (mysz) lub dotknięcie (telefon) zawodnika pokazuje jego imię
  i nazwisko; kliknięcie / drugie dotknięcie otwiera jego profil.
  Jasny motyw: białe stroje, ciemny motyw: czarne stroje.
*/
import { Image, getImage } from "astro:assets";
import heroLight from "../assets/start/hero-light.jpg";
import heroDark from "../assets/start/hero-dark.jpg";
import { ciemne, jasne, type Punkt } from "../data/zdjecie-druzyny";
import { type Lang, playerUrl, pozycje } from "../i18n/ui";
import { zawodnicy } from "../lib/data";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const players = await zawodnicy();
const byNum = new Map(players.map((p) => [p.data.numer, p]));

const fullLight = await getImage({ src: heroLight, width: 2400, format: "jpg" });
const fullDark = await getImage({ src: heroDark, width: 2400, format: "jpg" });
const pl = lang === "pl";
const warianty = [
  { k: "light", img: heroLight, full: fullLight.src, pts: jasne, alt: pl ? "Drużyna i sztab ŁKS CoolPack Łódź w białych strojach" : "ŁKS CoolPack Łódź players and staff in white kits" },
  { k: "dark", img: heroDark, full: fullDark.src, pts: ciemne, alt: pl ? "Drużyna i sztab ŁKS CoolPack Łódź w czarnych strojach" : "ŁKS CoolPack Łódź players and staff in black kits" },
];
const hint = pl ? "Wskaż zawodnika na zdjęciu" : "Point to a player in the photo";
const hintTouch = pl ? "Dotknij zawodnika na zdjęciu" : "Tap a player in the photo";
const zoom = pl ? "Powiększ zdjęcie drużyny" : "Enlarge the team photo";
---

<figure class="tp" data-team-photo>
  {
    warianty.map((v) => (
      <div class:list={["tp__pic", `tp__pic--${v.k}`]}>
        <Image class="tp__img" src={v.img} alt={v.alt} widths={[800, 1200, 1600, 2400]} sizes="100vw" loading="lazy" />
        <ul class="tp__spots" role="list">
          {Object.entries(v.pts as Record<number, Punkt>)
            .sort((a, b) => a[1].x - b[1].x)
            .map(([num, pt]) => {
            const p = byNum.get(Number(num));
            if (!p) return null;
            const edge = pt.x < 16 ? "tp__spot--l" : pt.x > 84 ? "tp__spot--r" : "";
            return (
              <li>
                <a
                  class:list={["tp__spot", edge]}
                  href={playerUrl(p.id, lang)}
                  data-bolt
                  data-slug={p.id}
                  style={`--x:${pt.x}%;--y:${pt.y}%`}
                  aria-label={`#${p.data.numer} ${p.data.imie} ${p.data.nazwisko}`}
                >
                  <span class="tp__dot" aria-hidden="true" />
                  <span class="tp__label" aria-hidden="true">
                    <b>#{p.data.numer}</b> {p.data.imie} <strong>{p.data.nazwisko}</strong>
                    <small>{pozycje(p.data.pozycje, lang)}</small>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
        <a class="tp__zoom" href={v.full} target="_blank" rel="noopener" aria-label={zoom}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6" /></svg>
        </a>
      </div>
    ))
  }
  <figcaption class="tp__hint">
    <span class="tp__hint-mouse">{hint}</span><span class="tp__hint-touch">{hintTouch}</span>
  </figcaption>
</figure>

<style>
  .tp {
    position: relative;
    margin: 0;
  }
  .tp__pic {
    position: relative;
  }
  :global([data-theme="dark"]) .tp__pic--light,
  :global([data-theme="light"]) .tp__pic--dark {
    display: none;
  }
  .tp__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tp__spots {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Obszar zawodnika: od głowy do pasa */
  .tp__spot {
    position: absolute;
    left: var(--x);
    top: calc(var(--y) - 3%);
    width: 7.2%;
    height: 36%;
    transform: translateX(-50%);
    border-radius: 40px 40px 12px 12px;
    -webkit-tap-highlight-color: transparent;
    outline-offset: 2px;
  }
  .tp__dot {
    position: absolute;
    left: 50%;
    top: 38%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.85);
    opacity: 0.9;
    transition: opacity 200ms, transform 200ms;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tp__dot::after {
      content: "";
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      border: 2px solid #fff;
      animation: tp-pulse 2.2s ease-out infinite;
      animation-delay: calc(var(--x) * 0.03s);
    }
  }
  @keyframes tp-pulse {
    0% { transform: scale(1); opacity: 0.9; }
    80%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .tp__label {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    z-index: 5;
    display: grid;
    justify-items: center;
    padding: 8px 12px 7px;
    border-radius: 10px;
    background: var(--red);
    color: #fff;
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
    transform: translate(-50%, 6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms, transform 200ms var(--ease);
  }
  .tp__label::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    margin-left: -7px;
    border: 7px solid transparent;
    border-top-color: var(--red);
  }
  .tp__label b {
    font-weight: 800;
  }
  .tp__label strong {
    font-weight: 800;
    font-size: 19px;
  }
  .tp__label small {
    margin-top: 2px;
    font-size: 11px;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }
  /* Krańcowi zawodnicy: dymek nie wychodzi poza ekran */
  .tp__spot--l .tp__label {
    left: 0;
    transform: translate(0, 6px);
  }
  .tp__spot--l .tp__label::after {
    left: 24px;
  }
  .tp__spot--r .tp__label {
    left: auto;
    right: 0;
    transform: translate(0, 6px);
  }
  .tp__spot--r .tp__label::after {
    left: auto;
    right: 17px;
  }

  .tp__spot:hover,
  .tp__spot:focus-visible,
  .tp__spot.is-active {
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.16), transparent);
    box-shadow: 0 0 0 2px rgba(255, 75, 75, 0.9), 0 0 30px rgba(212, 4, 20, 0.6);
  }
  .tp__spot:hover .tp__label,
  .tp__spot:focus-visible .tp__label,
  .tp__spot.is-active .tp__label {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .tp__spot--l:is(:hover, :focus-visible, .is-active) .tp__label,
  .tp__spot--r:is(:hover, :focus-visible, .is-active) .tp__label {
    transform: translate(0, 0);
  }
  .tp__spot:hover .tp__dot,
  .tp__spot.is-active .tp__dot {
    opacity: 0;
  }

  .tp__zoom {
    position: absolute;
    z-index: 4;
    right: 12px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(14, 12, 9, 0.7);
  }
  .tp__zoom svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .tp__hint {
    position: absolute;
    left: var(--gutter);
    bottom: 14px;
    z-index: 4;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(14, 12, 9, 0.7);
    color: #fff;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .tp__hint-touch {
    display: none;
  }
  @media (hover: none) {
    .tp__hint-mouse {
      display: none;
    }
    .tp__hint-touch {
      display: inline;
    }
  }

  /* Telefon: mniejsze dymki i kropki */
  @media (max-width: 700px), (orientation: landscape) and (max-height: 500px) {
    .tp__dot {
      width: 9px;
      height: 9px;
      margin-left: -4.5px;
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
    }
    /* dymek pod kropką, żeby nie chował się pod paskiem u góry */
    .tp__label {
      font-size: 12px;
      padding: 6px 9px 5px;
      bottom: auto;
      top: 52%;
    }
    .tp__label::after {
      top: auto;
      bottom: 100%;
      border-top-color: transparent;
      border-bottom-color: var(--red);
    }
    .tp__label strong {
      font-size: 15px;
    }
    .tp__label small {
      display: none;
    }
    /* na telefonie dół zdjęcia zajmuje nazwa drużyny — podpowiedź i lupa idą na górę */
    .tp__hint {
      font-size: 11px;
      bottom: auto;
      top: 8px;
      left: 10px;
    }
    .tp__zoom {
      width: 38px;
      height: 38px;
      bottom: auto;
      top: 8px;
      right: 8px;
    }
  }
</style>
