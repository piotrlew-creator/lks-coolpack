---
/* Strona zawodnika. Zdjęcie i numer „przylatują” z siatki składu. */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Silhouette from "../components/Silhouette.astro";
import PlayerStats from "../components/PlayerStats.astro";
import { type Lang, dataUr, kraj, liga, playerUrl, pozycje, route, t } from "../i18n/ui";
import { paragraphs, pick } from "../lib/data";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
  p: CollectionEntry<"zawodnicy">;
  prev: CollectionEntry<"zawodnicy">;
  next: CollectionEntry<"zawodnicy">;
}
const { lang, p, prev, next } = Astro.props;
const d = p.data;
const name = `${d.imie} ${d.nazwisko}`;
const bio = paragraphs(pick(d.opis, d.opisEn, lang));
const isLks = (klub: string) => klub.startsWith("ŁKS");
// Ciągły okres w ŁKS (od najnowszego sezonu) i klub sprzed przyjścia do ŁKS
let i = 0;
while (i < d.kariera.length && isLks(d.kariera[i].klub)) i++;
const odSezonu = i > 0 ? d.kariera[i - 1].sezon : undefined;
const poprzedni = d.kariera[i]?.klub;

const stats = [
  { k: t(lang, "team.position"), v: pozycje(d.pozycje, lang) },
  { k: t(lang, "team.height"), v: d.wzrost ? `${d.wzrost} cm` : undefined },
  { k: t(lang, "team.born"), v: dataUr(d.dataUrodzenia, lang) },
  { k: t(lang, "team.nation"), v: kraj(d.narodowosc, lang) },
  { k: t(lang, "team.since"), v: odSezonu },
  { k: t(lang, "team.prevClub"), v: poprzedni },
].filter((s) => s.v);
const desc =
  lang === "pl"
    ? `${name} (#${d.numer}, ${pozycje(d.pozycje, lang).toLowerCase()}) — zawodnik ŁKS CoolPack Łódź. Statystyki sezonu i kariera.`
    : `${name} (#${d.numer}, ${pozycje(d.pozycje, lang).toLowerCase()}) — ŁKS CoolPack Łódź player. Season stats and career.`;
---

<Base
  lang={lang}
  title={name}
  description={desc}
  alt={{ pl: playerUrl(p.id, "pl"), en: playerUrl(p.id, "en") }}
  active="sklad"
  ogImage={u(`og/zawodnicy/${p.id}.jpg`)}
  ogType="profile"
>
  <article class="pp" data-swipe data-prev={playerUrl(prev.id, lang)} data-next={playerUrl(next.id, lang)}>
    <div class="pp__flash" aria-hidden="true"></div>
    <div class="pp__stage">
      <div class="pp__frame">
      <span class="pp__num" aria-hidden="true">{d.numer}</span>
      <div class="pp__photo">
        {
          d.zdjecie ? (
            <Image src={d.zdjecie} alt={name} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 640px, 92vw" loading="eager" fetchpriority="high" />
          ) : (
            <Silhouette />
          )
        }
      </div>
      </div>
    </div>

    <div class="pp__info wrap">
      <a class="pp__back" href={route("sklad", lang)}>← {t(lang, "team.back")}</a>
      <p class="pp__swipe" aria-hidden="true">
        <span>‹</span> {t(lang, "swipe.hint")} <span>›</span>
      </p>
      <p class="pp__meta">
        <span class="pp__badge">#{d.numer}</span>
        <span>{pozycje(d.pozycje, lang)}</span>
        {d.kapitan && <span class="pp__cap">{t(lang, "team.captain")}</span>}
      </p>
      <h1 class="pp__name">
        <span class="pp__first">{d.imie}</span>
        <span class="pp__last">{d.nazwisko}</span>
      </h1>

      <dl class="pp__stats">
        {
          stats.map((s) => (
            <div>
              <dt>{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </article>

  <PlayerStats slug={p.id} lang={lang} />

  <section class="section pp__bio-sec">
    <div class="wrap pp__bio">
      <div class="pp__text">
        {bio.map((para) => <p>{para}</p>)}
      </div>
      {
        d.kariera.length > 0 && (
          <div class="career">
            <h2 class="career__h">{t(lang, "team.career")}</h2>
            <ol class="career__list">
              {d.kariera.map((k) => (
                <li class:list={["career__row", { "career__row--lks": isLks(k.klub) }]}>
                  <span class="career__season">{k.sezon}</span>
                  <span class="career__club">{k.klub}</span>
                  <span class:list={["career__league", `career__league--${k.liga}`]}>{liga(k.liga, lang)}</span>
                </li>
              ))}
            </ol>
            <p class="career__note">{t(lang, "team.career.note")}</p>
          </div>
        )
      }
    </div>
  </section>

  <nav class="pp__nav wrap" aria-label={t(lang, "team.title")}>
    <a href={playerUrl(prev.id, lang)} data-bolt class="pp__nav-a">
      <span class="pp__nav-k">← {t(lang, "team.prev")}</span>
      <span class="pp__nav-n">#{prev.data.numer} {prev.data.imie} {prev.data.nazwisko}</span>
    </a>
    <a href={playerUrl(next.id, lang)} data-bolt class="pp__nav-a pp__nav-a--next">
      <span class="pp__nav-k">{t(lang, "team.next")} →</span>
      <span class="pp__nav-n">#{next.data.numer} {next.data.imie} {next.data.nazwisko}</span>
    </a>
  </nav>
</Base>

<style>
  .pp {
    position: relative;
    display: grid;
    background:
      radial-gradient(80% 70% at 70% 20%, #4a0b10 0%, transparent 60%),
      linear-gradient(180deg, #120f0c 0%, #0b0907 100%);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
  }
  /* Monitor, iPad w poziomie i telefon w poziomie: tekst obok zdjęcia */
  @media (min-width: 900px), (min-width: 600px) and (orientation: landscape) and (max-height: 600px) {
    .pp {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      min-height: min(88svh, 860px);
    }
    .pp__stage {
      order: 2;
    }
  }

  .pp__flash {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: #fff;
    opacity: 0;
  }

  .pp__stage {
    position: relative;
    height: clamp(380px, 62vh, 760px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  /* Numer w lewym górnym rogu zdjęcia — zawsze w całości widoczny,
     nad tłem zdjęcia, ale z dala od twarzy zawodnika. */
  .pp__frame {
    position: relative;
    width: min(92%, 640px);
    height: 100%;
  }
  .pp__num {
    position: absolute;
    z-index: 3;
    left: 0;
    top: 4%;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(84px, 16vw, 168px);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--red);
    view-transition-name: player-number;
    text-shadow: 0 0 40px rgba(212, 4, 20, 0.55), 0 6px 18px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }
  .pp__photo {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    color: #fff;
    view-transition-name: player-photo;
  }
  /* Ciemne tło zdjęcia wtapia się w tło strony (lighten + miękkie krawędzie),
     a wielki numer prześwituje za zawodnikiem. */
  .pp__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    mix-blend-mode: lighten;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 74%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 18%, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 74%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-composite: intersect;
  }
  .pp__photo :global(.silhouette) {
    opacity: 0.22;
  }

  .pp__info {
    position: relative;
    padding-block: 8px clamp(32px, 6vw, 72px);
  }
  @media (min-width: 900px), (min-width: 600px) and (orientation: landscape) and (max-height: 600px) {
    .pp__info {
      padding-block: 0 clamp(48px, 8vh, 96px);
      max-width: none;
      padding-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    }
  }
  .pp__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 10px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cfc6bc;
    text-decoration: none;
  }
  .pp__back:hover {
    color: var(--red-on-dark);
  }
  .pp__swipe {
    display: none;
    margin: 0 0 10px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: clamp(11px, 3.4vw, 13px);
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    color: #a0968c;
  }
  .pp__swipe span {
    color: var(--red-on-dark);
    font-size: 18px;
  }
  @media (hover: none) and (pointer: coarse) {
    .pp__swipe {
      display: block;
    }
  }
  /* Na stronie zawodnika poziomy gest przełącza zawodników,
     a nie cofa przeglądarki do poprzedniej strony */
  :global(html) {
    overscroll-behavior-x: none;
  }
  /* Podczas przesuwania palcem zdjęcie i dane lekko „odjeżdżają” */
  .pp.is-swiping .pp__frame,
  .pp.is-swiping .pp__info {
    transform: translateX(var(--sx, 0px));
    opacity: var(--so, 1);
  }
  .pp.is-leaving .pp__frame,
  .pp.is-leaving .pp__info {
    transition: transform 220ms var(--ease), opacity 220ms;
  }
  .pp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ddd4ca;
  }
  .pp__badge {
    background: var(--red);
    color: #fff;
    padding: 4px 10px 3px;
    border-radius: 8px;
    font-weight: 800;
  }
  .pp__cap {
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 14px;
  }
  .pp__name {
    display: flex;
    flex-direction: column;
    margin: 0 0 28px;
    line-height: 0.86;
  }
  .pp__first {
    font-size: min(48px, 8cqi);
    font-weight: 700;
    color: #ddd4ca;
  }
  .pp__name {
    container-type: inline-size;
  }
  .pp__last {
    /* dopasowanie do szerokości: najdłuższe nazwisko mieści się w jednej linii */
    font-size: min(128px, 16cqi);
    white-space: nowrap;
  }
  .pp__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 680px;
  }
  @media (min-width: 600px) {
    .pp__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pp__stats div {
    background: rgba(14, 12, 9, 0.85);
    padding: 14px 16px;
    min-width: 0;
  }
  .pp__stats dt {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a0968c;
  }
  .pp__stats dd {
    margin: 4px 0 0;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(18px, 2.2vw, 24px);
    text-transform: uppercase;
    line-height: 1.1;
    hyphens: manual;
  }

  .pp__bio-sec {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .pp__bio {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
  }
  @media (min-width: 960px) {
    .pp__bio {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
  .pp__text {
    font-size: clamp(17px, 1.5vw, 19px);
    max-width: 62ch;
  }

  .career__h {
    font-size: clamp(26px, 3vw, 34px);
    margin-bottom: 16px;
  }
  .career__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .career__row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 6px 14px;
    align-items: center;
    padding: 10px 4px;
    border-bottom: 1px solid var(--border);
    font-size: 16px;
  }
  .career__row--lks {
    background: linear-gradient(90deg, color-mix(in srgb, var(--red) 12%, transparent), transparent 70%);
  }
  .career__row--lks .career__club {
    font-weight: 700;
  }
  .career__season {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .career__club {
    line-height: 1.3;
  }
  .career__league {
    justify-self: end;
    white-space: nowrap;
    padding: 3px 8px 2px;
    border-radius: 6px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .career__league--EKS {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .career__league--1L {
    border-color: var(--accent);
    color: var(--accent);
  }
  .career__note {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .career__row {
      grid-template-columns: 74px minmax(0, 1fr) auto;
      gap: 4px 10px;
      font-size: 15px;
    }
    .career__season {
      font-size: 14px;
    }
  }

  .pp__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding-bottom: clamp(48px, 7vw, 88px);
  }
  .pp__nav-a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color 160ms, transform 160ms;
  }
  .pp__nav-a:hover {
    border-color: var(--red);
    transform: translateY(-2px);
  }
  .pp__nav-a--next {
    text-align: right;
  }
  .pp__nav-k {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pp__nav-n {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(18px, 2.4vw, 26px);
    text-transform: uppercase;
    line-height: 1.05;
  }

  @media (orientation: landscape) and (max-height: 600px) {
    .pp {
      min-height: calc(100svh);
    }
    .pp__stage {
      height: calc(100svh - var(--header-h));
    }
    .pp__info {
      padding-block: 16px 24px;
    }
    .pp__name {
      margin-bottom: 14px;
    }
    .pp__stats div {
      padding: 8px 12px;
    }
    .pp__stats dd {
      font-size: 17px;
    }
    .pp__back {
      min-height: 36px;
      margin-bottom: 4px;
    }
  }

  /* Wejście na stronę: uderzenie pioruna za zawodnikiem */
  @media (prefers-reduced-motion: no-preference) {
    .pp__flash {
      animation: pp-flash 520ms ease-out both;
    }
    @keyframes pp-flash {
    0% { opacity: 0.0; }
    8% { opacity: 0.7; }
    18% { opacity: 0; }
    28% { opacity: 0.35; }
    100% { opacity: 0; }
  }
  @keyframes pp-num {
    from { opacity: 0; transform: translateX(-30px) scale(1.4); }
  }
  @keyframes pp-glow {
    0%, 100% { text-shadow: 0 0 40px rgba(212, 4, 20, 0.55), 0 6px 18px rgba(0, 0, 0, 0.6); }
    50% { text-shadow: 0 0 70px rgba(255, 75, 75, 0.9), 0 6px 18px rgba(0, 0, 0, 0.6); }
  }
  @keyframes pp-in {
    from { opacity: 0; transform: translateX(-30px); }
  }
</style>
