---
/* Grupy młodzieżowe — krótki opis drużyn ŁKS Koszykówka Męska i odnośnik do lkskmjunior.pl. */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { type Lang, ROUTES, t } from "../i18n/ui";
import { grupy, junior, koordynatorzy } from "../data/mlodziez";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tel = (n: string) => `tel:+48${n.replace(/\s/g, "")}`;
const coords = [
  { tytul: t(lang, "youth.joinBeg"), funkcja: t(lang, "youth.coordBeg"), k: koordynatorzy.naborowe },
  { tytul: t(lang, "youth.joinOld"), funkcja: t(lang, "youth.coordOrg"), k: koordynatorzy.organizacyjny },
];
---

<Base lang={lang} title={t(lang, "youth.title")} description={t(lang, "youth.lead")} alt={{ pl: u(ROUTES.mlodziez.pl), en: u(ROUTES.mlodziez.en) }} active="mlodziez">
  <PageHero kicker={t(lang, "youth.kicker")} title={t(lang, "youth.title")} lead={t(lang, "youth.lead")}>
    <a class="btn yt-site" href={junior.adres} target="_blank" rel="noopener">{t(lang, "youth.site")} ↗</a>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <dl class="facts">
        <div><dt>{junior.druzyn}</dt><dd>{t(lang, "youth.teams")}</dd></div>
        <div><dt>~{junior.zawodnikow}</dt><dd>{t(lang, "youth.players")}</dd></div>
        <div><dt>{t(lang, "youth.topLevel")}</dt><dd>{t(lang, "youth.top")}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="yt-groups">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "youth.groupsKicker")}</p>
          <h2 id="yt-groups" class="h-lg">{t(lang, "youth.groupsTitle")}</h2>
        </div>
      </div>
      <ul class="groups" role="list">
        {
          grupy.map((g, i) => (
            <li class:list={["reveal", { "groups__wide": !!g.opis }]} style={`--d:${Math.min(i, 6) * 50}ms`}>
              <a class="group" href={junior.adres + g.link} target="_blank" rel="noopener">
                <h3 class="group__name">{lang === "en" && g.nazwaEn ? g.nazwaEn : g.nazwa}</h3>
                <p class="group__age">{g.rocznik ? t(lang, "youth.born").replace("{r}", String(g.rocznik)) : t(lang, "youth.senior")}</p>
                {(lang === "en" ? g.opisEn : g.opis) && <p class="group__desc">{lang === "en" ? g.opisEn : g.opis}</p>}
                {g.trenerzy.length > 0 && (
                  <ul class="group__coach" role="list">
                    {g.trenerzy.map((c) => (
                      <li>{c.includes(":") ? c : `${t(lang, "youth.coach")} ${c}`}</li>
                    ))}
                  </ul>
                )}
                <span class="group__more">{t(lang, "youth.more")} ↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="yt-join">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "youth.joinKicker")}</p>
          <h2 id="yt-join" class="h-lg">{t(lang, "youth.joinTitle")}</h2>
        </div>
        <a class="btn btn--ghost" href={junior.dolacz} target="_blank" rel="noopener">{t(lang, "youth.join")} ↗</a>
      </div>
      <div class="join">
        {
          coords.map((c) => (
            <div class="card card--accent join__box">
              <h3 class="join__h">{c.tytul}</h3>
              <p class="join__who">
                {c.funkcja} — <strong>{c.k.imie}</strong>
              </p>
              <p class="join__line">
                tel.: <a href={tel(c.k.telefon)}>{c.k.telefon}</a>
              </p>
              <p class="join__line">
                e-mail: <a href={`mailto:${c.k.email}`}>{c.k.email}</a>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bardzo widoczny odnośnik do strony grup młodzieżowych -->
  <section class="section">
    <div class="wrap">
      <a class="site-cta reveal" href={junior.adres} target="_blank" rel="noopener">
        <span class="site-cta__kicker">{t(lang, "youth.ctaKicker")}</span>
        <span class="site-cta__domain">{junior.domena} ↗</span>
        <span class="site-cta__text">{t(lang, "youth.ctaText")}</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .yt-site {
    margin-top: clamp(18px, 2.4vw, 28px);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }
  .facts > div {
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .facts dt {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1;
    color: var(--red);
  }
  .facts dd {
    margin: 6px 0 0;
    overflow-wrap: anywhere;
    font-size: 14px;
    line-height: 1.3;
    color: var(--muted);
  }

  .groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .groups__wide {
    grid-column: 1 / -1;
  }
  .group {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(14px, 2.4vw, 20px) clamp(14px, 2.4vw, 20px) clamp(12px, 2vw, 18px);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: transform 200ms var(--ease), border-color 200ms var(--ease);
  }
  .group:hover {
    transform: translateY(-3px);
    border-color: var(--red);
  }
  .group__name {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1;
  }
  .group__age {
    margin: 6px 0 0;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.35;
  }
  .group__desc {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .group__coach {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
  }
  .group__more {
    margin-top: auto;
    padding-top: 14px;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
  }
  @media (min-width: 900px) {
    .groups {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .groups__wide {
      grid-column: span 2;
    }
  }

  .join {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 860px) {
    .join {
      grid-template-columns: 1fr 1fr;
    }
  }
  .join__h {
    margin: 0 0 10px;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.1;
  }
  .join__who {
    margin: 0 0 8px;
  }
  .join__line {
    margin: 0;
    line-height: 1;
  }
  .join__line a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--red);
    font-weight: 600;
  }

  .site-cta {
    display: grid;
    gap: 8px;
    padding: clamp(26px, 5vw, 52px);
    border-radius: var(--radius);
    background: var(--red);
    color: #fff;
    text-decoration: none;
    transition: transform 200ms var(--ease), background-color 200ms var(--ease);
  }
  .site-cta:hover {
    transform: translateY(-3px);
    background: var(--red-hover, #a8030f);
  }
  .site-cta__kicker {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.9;
  }
  .site-cta__domain {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(40px, 8vw, 96px);
    line-height: 0.95;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .site-cta__text {
    max-width: 56ch;
    font-size: clamp(15px, 1.6vw, 18px);
    opacity: 0.95;
  }
</style>
