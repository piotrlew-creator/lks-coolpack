---
/* Grupy młodzieżowe — krótkie wprowadzenie, duży odnośnik do lkskmjunior.pl i kontakt do koordynatorów. */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { type Lang, ROUTES, t } from "../i18n/ui";
import { junior, koordynatorzy } from "../data/mlodziez";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tel = (n: string) => `tel:+48${n.replace(/\s/g, "")}`;
const coords = [
  { tytul: t(lang, "youth.joinBeg"), funkcja: t(lang, "youth.coordBeg"), k: koordynatorzy.naborowe },
  { tytul: t(lang, "youth.joinOld"), funkcja: t(lang, "youth.coordOrg"), k: koordynatorzy.organizacyjny },
];
---

<Base lang={lang} title={t(lang, "youth.title")} description={t(lang, "youth.lead")} alt={{ pl: u(ROUTES.mlodziez.pl), en: u(ROUTES.mlodziez.en) }} active="mlodziez">
  <PageHero kicker={t(lang, "youth.kicker")} title={t(lang, "youth.title")} lead={t(lang, "youth.lead")}>
    <a class="btn yt-site" href={junior.adres} target="_blank" rel="noopener">{t(lang, "youth.site")} ↗</a>
  </PageHero>

  <section class="section" aria-labelledby="yt-join">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "youth.joinKicker")}</p>
          <h2 id="yt-join" class="h-lg">{t(lang, "youth.joinTitle")}</h2>
        </div>
        <a class="btn btn--ghost" href={junior.dolacz} target="_blank" rel="noopener">{t(lang, "youth.join")} ↗</a>
      </div>
      <div class="join">
        {
          coords.map((c) => (
            <div class="card card--accent join__box">
              <h3 class="join__h">{c.tytul}</h3>
              <p class="join__who">
                {c.funkcja} — <strong>{c.k.imie}</strong>
              </p>
              <p class="join__line">
                tel.: <a href={tel(c.k.telefon)}>{c.k.telefon}</a>
              </p>
              <p class="join__line">
                e-mail: <a href={`mailto:${c.k.email}`}>{c.k.email}</a>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

</Base>

<style>
  /* Duży przycisk do strony grup młodzieżowych */
  .yt-site {
    margin-top: clamp(20px, 3vw, 32px);
    min-height: 64px;
    padding-inline: 32px;
    font-size: clamp(18px, 2vw, 22px);
  }
  @media (max-width: 640px) {
    .yt-site {
      display: flex;
      width: 100%;
    }
  }

  .join {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 860px) {
    .join {
      grid-template-columns: 1fr 1fr;
    }
  }
  .join__h {
    margin: 0 0 10px;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.1;
  }
  .join__who {
    margin: 0 0 8px;
  }
  .join__line {
    margin: 0;
    line-height: 1;
  }
  .join__line a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--red);
    font-weight: 600;
  }
</style>
