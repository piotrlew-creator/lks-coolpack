---
/*
  Terminarz i wyniki — wszystkie mecze sezonu, pogrupowane według miesięcy.
  Dane: src/data/terminarz.json. Wynik prowadzi do strony meczu na 1lm.pzkosz.pl.
*/
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import LeagueLogos from "../components/LeagueLogos.astro";
import { klub } from "../data/klub";
import { type Lang, ROUTES, t } from "../i18n/ui";
import { aktualizacjaTabeli, aktualizacjaTerminarza, bilans, idMeczu, nastepny, sezon, tabela, terminarz, zrodloTabeli, zrodloTerminarza, type MeczLks } from "../lib/terminarz";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const loc = lang === "pl" ? "pl-PL" : "en-GB";
const b = bilans();

// Data meczu jest w czasie polskim — formatujemy ją „na sztywno”, bez stref
const dzien = (m: MeczLks) => {
  const [y, mo, d] = m.data.slice(0, 10).split("-").map(Number);
  return new Date(Date.UTC(y, mo - 1, d, 12));
};
const fmt = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(loc, { ...o, timeZone: "UTC" });
const fMiesiac = fmt({ month: "long", year: "numeric" });
const fDzienTyg = fmt({ weekday: "short" });

const grupy: { klucz: string; nazwa: string; mecze: MeczLks[]; rozegrany?: boolean; w?: number; p?: number }[] = [];
for (const m of terminarz) {
  const klucz = m.data.slice(0, 7);
  let g = grupy.at(-1);
  if (!g || g.klucz !== klucz) {
    const n = fMiesiac.format(dzien(m));
    g = { klucz, nazwa: n.charAt(0).toUpperCase() + n.slice(1), mecze: [] };
    grupy.push(g);
  }
  g.mecze.push(m);
}
// Miesiąc w całości rozegrany: na telefonie zwinięty (z bilansem w nagłówku)
for (const g of grupy) {
  g.rozegrany = g.mecze.every((m) => m.wygrana !== null);
  g.w = g.mecze.filter((m) => m.wygrana).length;
  g.p = g.mecze.filter((m) => m.wygrana === false).length;
}
const fData = new Intl.DateTimeFormat(loc, { day: "numeric", month: "long", year: "numeric" });
const aktualizacja = fData.format(new Date(aktualizacjaTerminarza));
const aktualizacjaT = fData.format(new Date(aktualizacjaTabeli));
const filtry = [
  { grupa: "miejsce", f: "dom", k: "sched.f.home" },
  { grupa: "miejsce", f: "wyjazd", k: "sched.f.away" },
  { grupa: "status", f: "rozegrane", k: "sched.f.played" },
  { grupa: "status", f: "nadchodzace", k: "sched.f.upcoming" },
] as const;
---

<Base
  lang={lang}
  title={t(lang, "sched.title")}
  description={t(lang, "sched.lead")}
  alt={{ pl: u(ROUTES.terminarz.pl), en: u(ROUTES.terminarz.en) }}
  active="terminarz"
>
  <PageHero kicker={`${t(lang, "sched.kicker")} ${sezon}`} title={t(lang, "sched.title")} lead={t(lang, "sched.lead")}>
    <div class="sched-liga"><LeagueLogos height={56} tylko="1lm" /></div>
  </PageHero>

  {
    klub.transmisja.link && (
      <section class="section sched-tv-sec">
        <div class="wrap">
          <div class="card card--accent sched-tv">
            <div>
              <p class="kicker">{t(lang, "sched.tvTitle")}</p>
              <p class="sched-tv__text">{t(lang, "sched.tvText")}</p>
            </div>
            <a class="btn" href={klub.transmisja.link} target="_blank" rel="noopener">{t(lang, "sched.tvCta")}</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section sched">
    <div class="wrap">
      <dl class="rec">
        <div class="rec__main">
          <dt>{t(lang, "sched.record")}</dt>
          <dd>{b.razem.w}<span>–</span>{b.razem.p}</dd>
        </div>
        <div>
          <dt>{t(lang, "sched.home")}</dt>
          <dd>{b.dom.w}–{b.dom.p}</dd>
        </div>
        <div>
          <dt>{t(lang, "sched.away")}</dt>
          <dd>{b.wyjazd.w}–{b.wyjazd.p}</dd>
        </div>
        <div>
          <dt>{t(lang, "sched.played")}</dt>
          <dd>{b.rozegrane}<small> {t(lang, "sched.of")} {b.wszystkie}</small></dd>
        </div>
      </dl>

      <div class="jumps">
        {nastepny && <a class="jump" href="#najblizszy">{t(lang, "sched.jump")}</a>}
        <a class="jump" href="#tabela">{t(lang, "sched.toTable")}</a>
      </div>

      <div class="sfilter" role="group" aria-label={t(lang, "sched.filter")} data-sched-filter>
        {filtry.map((x) => (
          <button type="button" class="chip" data-grupa={x.grupa} data-f={x.f} aria-pressed="false">
            <span class="chip__box" aria-hidden="true"></span>
            {t(lang, x.k)}
          </button>
        ))}
        <button type="button" class="chip chip--clear" data-f-clear hidden>{t(lang, "sched.f.clear")} ✕</button>
      </div>
      <p class="sfilter__none" data-sched-none hidden>{t(lang, "sched.f.none")}</p>

      {
        grupy.map((g) => (
          <details class="month" data-rozegrany={g.rozegrany ? "" : undefined} open={g.rozegrany ? undefined : true}>
            <summary class="month__h">
              <span>{g.nazwa}</span>
              {g.rozegrany && (
                <span class="month__sum">
                  {g.mecze.length} {t(lang, g.mecze.length === 1 ? "sched.game" : g.mecze.length < 5 ? "sched.games2" : "sched.games5")} · {g.w}–{g.p}
                </span>
              )}
            </summary>
            <ol class="games" role="list">
              {g.mecze.map((m) => {
                const next = m === nastepny;
                return (
                  <li
                    class:list={["game", { "game--next": next, "game--w": m.wygrana === true, "game--l": m.wygrana === false, "game--tix": m.wygrana === null && m.dom && !!m.bilety }]}
                    id={next ? "najblizszy" : undefined}
                    data-miejsce={m.dom ? "dom" : "wyjazd"}
                    data-status={m.wygrana === null ? "nadchodzace" : "rozegrane"}
                  >
                    <time class="game__date" datetime={m.data}>
                      <span class="game__day">{Number(m.data.slice(8, 10))}</span>
                      <span class="game__wd">{fDzienTyg.format(dzien(m)).replace(".", "")}</span>
                    </time>
                    <div class="game__info">
                      {next && <p class="game__flag">{t(lang, "sched.next")}</p>}
                      <p class="game__opp">{m.rywal}</p>
                      <p class="game__meta">
                        <span class:list={["game__tag", { "game__tag--home": m.dom }]}>{t(lang, m.dom ? "sched.vsHome" : "sched.vsAway")}</span>
                        {m.dom ? <a class="game__hall" href={klub.kontakt.hala.mapa} target="_blank" rel="noopener">{klub.kontakt.hala.nazwaKrotka}</a> : m.miasto && <span>{m.miasto}</span>}
                        <span>{m.godzina ? m.data.slice(11, 16) : t(lang, "sched.tbd")}</span>
                      </p>
                    </div>
                    <div class="game__res">
                      {m.wygrana === null ? (
                        <span class="game__acts">
                          {m.dom && m.bilety && (
                            <a class="game__tix" href={m.bilety} target="_blank" rel="noopener">
                              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2.2a2.8 2.8 0 0 0 0 5.6V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.2a2.8 2.8 0 0 0 0-5.6V7Zm11 0.5v2h1.6v-2H14Zm0 3.5v2h1.6v-2H14Zm0 3.5v2h1.6v-2H14Z"/></svg>
                              {t(lang, "match.buyShort")}
                            </a>
                          )}
                          <a
                            class="game__cal"
                            href={u(lang === "pl" ? `kalendarz/${idMeczu(m)}.ics` : `en/calendar/${idMeczu(m)}.ics`)}
                            aria-label={`${t(lang, "match.calendar")}: ${m.rywal}`}
                            title={t(lang, "match.calendar")}
                          >
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm12 8H5v9h14v-9ZM5 6v2h14V6H5Zm6 5h2v2.5h2.5v2H13V18h-2v-2.5H8.5v-2H11V11Z"/></svg>
                          </a>
                        </span>
                      ) : (
                        <a class="game__score" href={m.link} target="_blank" rel="noopener" title={t(lang, "sched.stats")}>
                          <span class="game__wl" aria-label={t(lang, m.wygrana ? "sched.winLong" : "sched.lossLong")}>
                            {t(lang, m.wygrana ? "sched.win" : "sched.loss")}
                          </span>
                          <span class="game__pts">
                            {m.lks}:{m.rywalPkt}
                          </span>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
          </details>
        ))
      }

      <script is:inline>
        // Na szerszym ekranie wszystkie miesiące rozwinięte; na telefonie rozegrane są zwinięte
        if (window.matchMedia("(min-width: 900px)").matches) {
          document.querySelectorAll("details.month").forEach(function (d) { d.open = true; });
        }
      </script>

      <p class="source">
        {t(lang, "sched.source")} {aktualizacja}. <a href={zrodloTerminarza} target="_blank" rel="noopener">1lm.pzkosz.pl</a>
      </p>

      <!-- Tabela ligowa -->
      <section class="tbl" id="tabela" aria-labelledby="tabela-h">
        <h2 class="tbl__h" id="tabela-h">{t(lang, "table.title")}</h2>
        <div class="tbl__scroll">
          <table class="league">
            <thead>
              <tr>
                <th scope="col" class="c-pos"><abbr title={t(lang, "table.pos")}>#</abbr></th>
                <th scope="col" class="c-team">{t(lang, "table.team")}</th>
                <th scope="col"><abbr title={t(lang, "table.gpLong")}>{t(lang, "table.gp")}</abbr></th>
                <th scope="col"><abbr title={t(lang, "table.wlLong")}>{t(lang, "table.wl")}</abbr></th>
                <th scope="col" class="c-wide">{t(lang, "table.home")}</th>
                <th scope="col" class="c-wide">{t(lang, "table.away")}</th>
                <th scope="col" class="c-wide"><abbr title={t(lang, "table.diffLong")}>{t(lang, "table.diff")}</abbr></th>
                <th scope="col" class="c-pts"><abbr title={t(lang, "table.ptsLong")}>{t(lang, "table.pts")}</abbr></th>
              </tr>
            </thead>
            <tbody>
              {tabela.map((w) => (
                <tr class:list={[{ "is-lks": w.lks, "z-po": w.strefa === "playoff", "z-sp": w.strefa === "spadek" }]} aria-current={w.lks ? "true" : undefined}>
                  <td class="c-pos">{w.miejsce}</td>
                  <th scope="row" class="c-team">
                    <a href={w.link} target="_blank" rel="noopener">{w.druzyna}</a>
                  </th>
                  <td>{w.mecze}</td>
                  <td>{w.bilans[0]}–{w.bilans[1]}</td>
                  <td class="c-wide">{w.dom[0]}–{w.dom[1]}</td>
                  <td class="c-wide">{w.wyjazd[0]}–{w.wyjazd[1]}</td>
                  <td class="c-wide">{w.roznica > 0 ? `+${w.roznica}` : w.roznica}</td>
                  <td class="c-pts">{w.pkt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="tbl__legend" role="list">
          <li><span class="lg lg--po" aria-hidden="true"></span>{t(lang, "table.playoff")}</li>
          <li><span class="lg lg--sp" aria-hidden="true"></span>{t(lang, "table.releg")}</li>
        </ul>
        <p class="source">
          {t(lang, "table.source")} {aktualizacjaT}. <a href={zrodloTabeli} target="_blank" rel="noopener">1lm.pzkosz.pl</a>
        </p>
      </section>
    </div>
  </section>
</Base>

<style>
  .sched-tv {
    display: grid;
    gap: 16px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .sched-tv {
      grid-template-columns: 1fr auto;
    }
  }
  .sched-tv__text {
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
  }
  .sched-liga {
    margin-top: clamp(16px, 2.4vw, 24px);
  }
  .league,
  .tbl__legend {
    --zone-po: #1e8e3e;
    --zone-po-bg: #e8f5ec;
    --zone-sp: #e8590c;
    --zone-sp-bg: #fdeee5;
  }
  .sched {
    padding-top: clamp(28px, 4vw, 48px);
  }
  /* -- Bilans --------------------------------------------------- */
  .rec {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 0 0 clamp(20px, 3vw, 32px);
  }
  .rec > div {
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    border: 1px solid var(--border);
  }
  .rec dt {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rec dd {
    margin: 4px 0 0;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1;
  }
  .rec dd small {
    font-size: 0.5em;
    font-weight: 700;
    color: var(--muted);
  }
  .rec__main {
    background: var(--red) !important;
    border-color: var(--red) !important;
    color: #fff;
  }
  .rec__main dt {
    color: rgba(255, 255, 255, 0.8);
  }
  .rec__main dd span {
    opacity: 0.7;
    margin-inline: 2px;
  }
  @media (max-width: 560px) {
    .rec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .jump {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-cond);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .jump:hover {
    text-decoration: underline;
  }

  /* -- Miesiące i mecze ---------------------------------------- */
  .month {
    margin-top: clamp(20px, 3vw, 32px);
  }
  .month__h {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin: 0 0 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--text);
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(20px, 2.4vw, 26px);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }
  .month__h::-webkit-details-marker {
    display: none;
  }
  .month__h::after {
    content: "";
    margin-left: auto;
    width: 10px;
    height: 10px;
    border-right: 2.5px solid currentColor;
    border-bottom: 2.5px solid currentColor;
    transform: translateY(-3px) rotate(45deg);
    transition: transform 200ms;
  }
  .month[open] > .month__h::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .month__sum {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .month:not([open]) > .month__h {
    margin-bottom: 0;
  }
  .games {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .game {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .game__date {
    display: grid;
    justify-items: center;
    line-height: 1;
    font-family: var(--font-cond);
  }
  .game__day {
    font-weight: 800;
    font-size: 30px;
  }
  .game__wd {
    margin-top: 3px;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .game__info p {
    margin: 0;
  }
  .game__flag {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .game__opp {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.15;
    text-transform: uppercase;
  }
  .game__vs {
    color: var(--muted);
    font-weight: 600;
    text-transform: none;
  }
  .game__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 4px !important;
    font-size: 14px;
    color: var(--muted);
  }
  .game__tag {
    white-space: nowrap;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .game__tag--home {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .game__res {
    text-align: right;
  }
  .game__acts {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .game__cal,
  .game__tix {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 200ms, color 200ms;
  }
  .game__cal:hover,
  .game__tix:hover {
    border-color: var(--red);
    color: var(--red);
  }
  .game__tix {
    gap: 6px;
    padding-inline: 14px;
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .game__tix:hover {
    color: #fff;
    background: var(--red-hover, #a8030f);
  }
  .game__hall {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-block: -6px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .game__score {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 10px 6px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-cond);
    transition: border-color 160ms, background 160ms;
  }
  .game__score:hover {
    border-color: var(--accent);
  }
  .game__wl {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 17px;
  }
  .game--w .game__wl {
    background: var(--red);
    color: #fff;
  }
  .game--l .game__wl {
    background: transparent;
    border: 2px solid var(--muted);
    color: var(--muted);
  }
  .game__pts {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .game__ext {
    font-size: 14px;
    color: var(--muted);
  }
  .game__pending {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 20px;
    color: var(--muted);
  }
  .game--next {
    margin-inline: -12px;
    padding-inline: 16px 12px;
    border-radius: var(--radius-sm);
    border-bottom-color: transparent;
    background: var(--bg-2);
    box-shadow: inset 4px 0 0 var(--red);
  }

  @media (max-width: 480px) {
    .game {
      grid-template-columns: 44px minmax(0, 1fr) auto;
      gap: 10px;
    }
    /* mecz z biletami: przyciski w osobnym wierszu pod nazwą rywala, żeby nie ściskały tekstu */
    .game--tix .game__res {
      grid-column: 2 / -1;
      justify-self: stretch;
      text-align: left;
    }
    .game--tix .game__acts {
      display: flex;
    }
    .game--tix .game__tix {
      flex: 1 1 auto;
    }
    .game__day {
      font-size: 26px;
    }
    .game__pts {
      font-size: 20px;
    }
    .game__ext {
      display: none;
    }
    .game__score {
      padding-right: 8px;
    }
  }

  /* -- Filtry ------------------------------------------------- */
  .sfilter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 4px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-cond);
