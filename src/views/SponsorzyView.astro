---
/* Sponsorzy — pogrupowani według poziomu + zaproszenie dla firm. */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import { sponsorom } from "../data/marketing";
import { klub } from "../data/klub";
import { type Lang, ROUTES, poziomGrupa, route, t } from "../i18n/ui";
import { POZIOMY_SPONSORA } from "../lib/consts";
import { sponsorzy } from "../lib/data";
import { telHref, u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = await sponsorzy();
const groups = POZIOMY_SPONSORA.map((lvl) => ({ lvl, items: all.filter((s) => s.data.poziom === lvl) })).filter((g) => g.items.length);
// Kontakt dla firm: osobna osoba od sponsoringu, a jeśli jej nie ma — biuro Klubu
const k = klub.kontakt;
const sp = k.sponsoring.telefon || k.sponsoring.email ? k.sponsoring : { osoba: "", telefon: k.biuro.telefon, email: k.biuro.email };
---

<Base lang={lang} title={t(lang, "sponsors.title")} description={t(lang, "sponsors.meta")} alt={{ pl: u(ROUTES.sponsorzy.pl), en: u(ROUTES.sponsorzy.en) }} active="sponsorzy">
  <PageHero kicker={t(lang, "sponsors.kicker")} title={t(lang, "sponsors.title")} lead={t(lang, "sponsors.lead")} />

  <!-- Dlaczego warto wspierać ŁKS — liczby i argumenty dla firm -->
  <section class="section" aria-labelledby="why-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{sponsorom.kicker[lang]}</p>
          <h2 id="why-h" class="h-lg">{sponsorom.tytul[lang]}</h2>
          <p class="lead">{sponsorom.lead[lang]}</p>
        </div>
      </div>
      <dl class="nums">
        {
          sponsorom.liczby.map((n) => (
            <div class="reveal">
              <dt>{n.wartosc}</dt>
              <dd>{n.opis[lang]}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="why" role="list">
        {
          sponsorom.kafle.map((k, i) => (
            <li class="why__item reveal" style={`--d:${i * 60}ms`}>
              <FeatureIcon name={k.ikona} />
              <h3 class="why__h">{k.tytul[lang]}</h3>
              <p class="why__t">{k.tekst[lang]}</p>
            </li>
          ))
        }
      </ul>
      <a class="btn why__cta" href="#dla-firm">{sponsorom.cta[lang]} ↓</a>
    </div>
  </section>

  <section class="section" aria-labelledby="tiers-h">
    <div class="wrap">
      <h2 id="tiers-h" class="h-lg tiers-h">{t(lang, "sponsors.ours")}</h2>
      {
        groups.map((g) => (
          <div class="tier">
            <h2 class="tier__h">{poziomGrupa(g.lvl, g.items.length, lang)}</h2>
            <ul class:list={["tier__list", { "tier__list--top": g.lvl === "Sponsor tytularny", "tier__list--mid": g.lvl === "Sponsor strategiczny" }]} role="list">
              {g.items.map((s) => {
                // sponsor bez strony www: kafel bez linku
                const Tag = s.data.link ? "a" : "div";
                const linkProps = s.data.link ? { href: s.data.link, target: "_blank", rel: "noopener" } : {};
                return (
                  <li class="reveal">
                    <Tag class:list={["sp", { "sp--nolink": !s.data.link }]} {...linkProps}>
                      {s.data.logo ? (
                        <>
                          <Image src={s.data.logo} alt={s.data.nazwa} height={g.lvl === "Sponsor tytularny" ? 96 : g.lvl === "Sponsor strategiczny" ? 80 : 64} />
                        </>
                      ) : (
                        <span class="sp__name">{s.data.nazwa}</span>
                      )}
                    </Tag>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section join" id="dla-firm">
    <div class="wrap">
    <div class="card join__in">
      <div>
        <p class="kicker">{t(lang, "sponsors.join.kicker")}</p>
        <h2 class="h-lg">{t(lang, "sponsors.join.title")}</h2>
        <p class="lead">{t(lang, "sponsors.join.text")}</p>
      </div>
      <div class="join__cta">
        {sp.osoba && <p class="join__who">{sp.osoba}</p>}
        <div class="btn-row">
          {sp.telefon && <a class="btn" href={telHref(sp.telefon)}>{t(lang, "contact.tel")} {sp.telefon}</a>}
          {sp.email && <a class="btn btn--ghost" href={`mailto:${sp.email}`}>{sp.email}</a>}
          {!sp.telefon && !sp.email && <a class="btn" href={route("kontakt", lang)}>{t(lang, "sponsors.join.cta")} →</a>}
        </div>
      </div>
    </div>
    </div>
  </section>
</Base>

<style>
  .nums {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 16px;
  }
  @media (min-width: 900px) {
    .nums {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .nums > div {
    padding: 18px 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .nums dt {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(30px, 4.4vw, 48px);
    line-height: 1;
    color: var(--red);
    white-space: nowrap;
  }
  .nums dd {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.35;
    color: var(--muted);
  }
  .why {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .why__item {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .why__h {
    margin: 12px 0 6px;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.1;
  }
  .why__t {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
  .why__cta {
    margin-top: 20px;
  }
  .tiers-h {
    margin: 0 0 clamp(20px, 3vw, 32px);
  }
  .tier + .tier {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .tier__h {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: clamp(22px, 2.6vw, 30px);
    margin-bottom: 20px;
  }
  .tier__h::after {
    content: "";
    flex: 1;
    height: 2px;
    background: var(--border);
  }
  .tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, calc(50% - 8px)), 1fr));
    gap: 16px;
  }
  .tier__list--top {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  }
  .sp {
    display: grid;
    place-items: center;
    min-height: clamp(110px, 22vw, 140px);
    padding: clamp(16px, 4vw, 28px);
    border-radius: var(--radius);
    background: var(--bg-2);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: border-color 200ms, transform 200ms, box-shadow 200ms;
  }
  /* Sponsor strategiczny: kafel średni — między tytularnym a partnerami */
  .tier__list--mid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }
  @media (min-width: 900px) {
    .tier__list--mid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .tier__list--mid .sp {
    min-height: clamp(120px, 24vw, 180px);
  }
  .tier__list--mid .sp :global(img) {
    max-height: 80px;
  }
  .tier__list--top .sp {
    min-height: clamp(130px, 30vw, 240px);
  }
  .sp--nolink:hover {
    transform: none;
    box-shadow: none;
  }
  .sp:hover {
    border-color: var(--red);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .sp :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 64px;
  }
  .tier__list--top .sp :global(img) {
    max-height: 96px;
  }
  .sp__name {
    text-align: center;
    line-height: 1.1;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(18px, 4.6vw, 28px);
    text-transform: uppercase;
  }

  .join__in {
    border-left: 5px solid var(--red);
    display: grid;
    gap: 28px;
    align-items: end;
  }
  @media (min-width: 900px) {
    .join__in {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .join__who {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 24px;
    text-transform: uppercase;
  }
</style>
