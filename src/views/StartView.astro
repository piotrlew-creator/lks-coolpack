---
/* Strona startowa (wspólna dla PL i EN). */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PlayerCard from "../components/PlayerCard.astro";
import Social from "../components/Social.astro";
import MatchCard from "../components/MatchCard.astro";
import NewsCard from "../components/NewsCard.astro";
import heroLight from "../assets/start/hero-light.jpg";
import heroDark from "../assets/start/hero-dark.jpg";
import herbBialy from "../assets/logo/herb-bialy.png";
import herbCzerwony from "../assets/logo/herb-czerwony.png";
import { klub, najblizszyMecz } from "../data/klub";
import { type Lang, ROUTES, route, t } from "../i18n/ui";
import { aktualnosci, sponsorzy as getSponsorzy, zawodnicy as getZawodnicy } from "../lib/data";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const players = (await getZawodnicy()).slice(0, 8);
const sponsors = (await getSponsorzy()).filter((s) => s.data.logo);


const wpisy = (await aktualnosci()).slice(0, 3);
const mecz = najblizszyMecz;
---

<Base lang={lang} alt={{ pl: u(ROUTES.start.pl), en: u(ROUTES.start.en) }} active="start">
  <!-- ══════════════ HERO ══════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__top">
    <div class="hero__year" aria-hidden="true">{klub.rokZalozenia}</div>

    <!-- Nazwa drużyny „nachodzi” na górę zdjęcia (ciemna ściana nad głowami) -->
    <div class="hero__in wrap">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__t1">ŁKS</span>
        <span class="hero__t2">CoolPack <span class="nw">Łódź</span></span>
      </h1>
      <div class="hero__crest" aria-hidden="true">
        <Image class="hero__crest-dark" src={herbBialy} alt="" width={320} height={321} loading="eager" />
        <Image class="hero__crest-light" src={herbCzerwony} alt="" width={320} height={321} loading="eager" />
      </div>
    </div>

    <!-- Zdjęcie drużyny: białe stroje w jasnym motywie, czarne w ciemnym -->
    <div class="hero__team">
      <Image
        class="hero__img hero__img--light"
        src={heroLight}
        alt={lang === "pl" ? "Drużyna i sztab ŁKS CoolPack Łódź w białych strojach" : "ŁKS CoolPack Łódź players and staff in white kits"}
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="lazy"
      />
      <Image
        class="hero__img hero__img--dark"
        src={heroDark}
        alt={lang === "pl" ? "Drużyna i sztab ŁKS CoolPack Łódź w czarnych strojach" : "ŁKS CoolPack Łódź players and staff in black kits"}
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
    </div>

    <div class="hero__foot wrap">
      <p class="hero__sub">{t(lang, "hero.sub")}</p>
      <div class="btn-row btn-row--equal">
        <a class="btn" href={route("sklad", lang)}>{t(lang, "hero.cta.team")}</a>
        <a class="btn btn--ghost" href={route("aktualnosci", lang)}>{t(lang, "hero.cta.news")}</a>
      </div>
    </div>
  </section>

  <!-- ══════════════ AKTUALNOŚCI: najbliższy mecz + najnowsze wpisy ══════════════ -->
  <section class="section news-home" aria-labelledby="news-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "news.kicker")}</p>
          <h2 id="news-h" class="h-lg">{t(lang, "news.title")}</h2>
        </div>
        <a class="btn btn--ghost" href={route("aktualnosci", lang)}>{t(lang, "news.all")} →</a>
      </div>
      {
        mecz && (
          <div class="news-home__match reveal">
            <MatchCard lang={lang} data={mecz.data} rywal={mecz.rywal} dom={mecz.dom} miejsce={mecz.hala} bilety={mecz.bilety} transmisja={mecz.transmisja} />
          </div>
        )
      }
      <div class="news-home__league reveal" data-po-meczu hidden={mecz ? true : undefined}>
        <div>
          <p class="kicker">{t(lang, "match.none.title")}</p>
          <p class="news-home__text">{t(lang, "match.none.text")}</p>
        </div>
        <a class="btn" href={klub.stronaLigi} target="_blank" rel="noopener">{t(lang, "match.none.cta")} ↗</a>
      </div>
      {
        wpisy.length > 0 && (
          <ul class="news-home__list" role="list">
            {wpisy.map((w, i) => <li><NewsCard w={w} lang={lang} index={i} /></li>)}
          </ul>
        )
      }
    </div>
  </section>

  <!-- ══════════════ SKŁAD ══════════════ -->
  <section class="section" aria-labelledby="sklad-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "team.kicker")}</p>
          <h2 id="sklad-title" class="h-lg">{t(lang, "team.title")}</h2>
          <p class="lead">{t(lang, "team.lead")}</p>
        </div>
        <a class="btn btn--ghost" href={route("sklad", lang)}>{t(lang, "team.all")} →</a>
      </div>
    </div>
    <ul class="rail" role="list">
      {players.map((p, i) => <li><PlayerCard p={p} lang={lang} index={i} /></li>)}
    </ul>
  </section>

  <!-- ══════════════ SZTAB + AKADEMIA ══════════════ -->
  <section class="section section--alt">
    <div class="wrap duo">
      <a class="panel panel--red reveal" href={route("sztab", lang)}>
        <p class="kicker">{t(lang, "staff.kicker")}</p>
        <h2 class="h-lg">{t(lang, "staff.title")}</h2>
        <p>{t(lang, "staff.lead")}</p>
        <span class="panel__cta">{t(lang, "staff.cta")} →</span>
      </a>
      <a class="panel panel--dark reveal" style="--d:120ms" href={klub.akademia.adres} target="_blank" rel="noopener">
        <p class="kicker">{t(lang, "academy.kicker")}</p>
        <h2 class="h-lg">{t(lang, "academy.title")}</h2>
        <p>{t(lang, "academy.text")}</p>
        <span class="panel__cta">{t(lang, "academy.cta")} ↗</span>
      </a>
    </div>
  </section>

  <!-- ══════════════ AKTUALNOŚCI / SOCIAL ══════════════ -->
  <section class="section section--dark social-band" aria-labelledby="news-title">
    <div class="wrap social-band__in">
      <div>
        <p class="kicker">{t(lang, "news.kicker")}</p>
        <h2 id="news-title" class="h-lg">{t(lang, "news.follow")}</h2>
        <p class="lead">{t(lang, "news.lead")}</p>
      </div>
      <div class="social-band__cta">
        <Social lang={lang} size="lg" />
        <a class="btn" href={route("aktualnosci", lang)}>{t(lang, "news.title")} →</a>
      </div>
    </div>
  </section>

  <!-- ══════════════ SPONSORZY ══════════════ -->
  {
    sponsors.length > 0 && (
      <section class="section sponsors-band" aria-labelledby="sp-title">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">{t(lang, "sponsors.kicker")}</p>
              <h2 id="sp-title" class="h-md">{t(lang, "sponsors.title")}</h2>
            </div>
            <a class="btn btn--ghost" href={route("sponsorzy", lang)}>{t(lang, "sponsors.join.title")} →</a>
          </div>
          <ul class="logos" role="list">
            {sponsors.map((s) => (
              <li class="reveal">
                <a class:list={[{ "has-mono": s.data.logoMono }]} href={s.data.link} target="_blank" rel="noopener" aria-label={s.data.nazwa}>
                  <Image class="logo-light" src={s.data.logo!} alt={s.data.nazwa} height={56} />
                  {s.data.logoMono && <Image class="logo-dark" src={s.data.logoMono} alt="" height={56} />}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* -- Hero ------------------------------------------------------
     Tekst na ciemnym tle, pod nim pełna szerokość zdjęcia drużyny
     (cała drużyna zawsze widoczna — także na telefonie).            */
  .hero {
    --hero-bg: #0f0c0a;
    position: relative;
    background:
      radial-gradient(70% 60% at 80% 10%, #3b0a0e 0%, transparent 60%),
      linear-gradient(180deg, #120f0c 0%, #0b0907 100%);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
  }
  .hero__year {
    position: absolute;
    z-index: -1;
    right: -2vw;
    top: calc(var(--header-h) - 2vw);
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(140px, 28vw, 420px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.07);
    user-select: none;
  }
  .hero__in {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-block: clamp(28px, 5vh, 56px) 0;
    pointer-events: none;
  }
  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
    padding-block: clamp(16px, 2vw, 28px) clamp(36px, 5vw, 56px);
  }
  .hero__foot .hero__sub {
    margin: 0;
  }
  .hero__crest {
    flex: none;
    width: clamp(96px, 16vw, 220px);
  }
  .hero__crest :global(img) {
    width: 100%;
    height: auto;
  }
  .hero__kicker {
    color: #fff;
  }
  .hero__kicker::before {
    background: var(--red);
  }
  .hero__title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.22em;
    line-height: 0.86;
  }
  .hero__t1 {
    font-size: clamp(64px, 11vw, 150px);
  }
  .hero__t2 {
    font-size: clamp(40px, 7vw, 96px);
    color: var(--red-on-dark);
  }
  .hero__sub {
    max-width: 60ch;
    font-size: clamp(16px, 1.5vw, 19px);
    color: #ddd4ca;
  }
  /* Zdjęcie podjeżdża pod dolną część nazwy — tylko na pas ściany nad
     głowami zawodników (ok. 15% wysokości zdjęcia), nikogo nie zasłania. */
  .hero__team {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * min(7vw, 130px));
    overflow: clip; /* zdjęcie nie wystaje poza ramkę podczas animacji wejścia */
  }
  :global(html[data-theme="dark"] .hero__team .hero__img--light),
  :global(html[data-theme="light"] .hero__team .hero__img--dark) {
    display: none;
  }
  .hero__team::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    pointer-events: none;
    bottom: 0;
    height: 8%;
    background: linear-gradient(transparent, var(--bg));
  }
  .hero__team :global(.hero__img) {
    display: block;
    width: 100%;
    height: auto;
    /* górna krawędź zdjęcia płynnie przechodzi w tło */
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.35) 0%, #000 14%);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.35) 0%, #000 14%);
  }
  /* Jasny motyw: białe tło pod tytułem, ciemne napisy, czerwony herb */
  :global([data-theme="light"]) .hero {
    --hero-bg: #ffffff;
    background: #ffffff;
    color: var(--black);
  }
  :global([data-theme="light"]) .hero__team :global(.hero__img) {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 12%, #000 18%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 12%, #000 18%);
  }
  :global([data-theme="light"]) .hero__sub {
    color: #4a423b;
  }
  :global([data-theme="light"]) .hero__t2 {
    color: var(--red);
  }
  :global([data-theme="light"]) .hero__year {
    -webkit-text-stroke-color: rgba(23, 20, 15, 0.07);
  }
  :global([data-theme="light"]) .hero .btn--ghost {
    color: var(--black);
  }
  .hero__crest-light,
  :global([data-theme="light"]) .hero__crest-dark {
    display: none;
  }
  :global([data-theme="light"]) .hero__crest-light {
    display: block;
  }

  /* Monitor i tablet w jasnym motywie: pas z nazwą i zdjęciem ma ciemne tło
     (jak pasek nawigacji i ściana na zdjęciu), biało dopiero pod zdjęciem. */
  .hero__top {
    position: relative;
  }
  @media (min-width: 701px) and (min-height: 501px), (min-width: 701px) and (orientation: portrait) {
    :global(html[data-theme="light"]) .hero__top {
      background: var(--black);
      color: #fff;
    }
    :global(html[data-theme="light"]) .hero__top .hero__t2 {
      color: var(--red-on-dark);
    }
    :global(html[data-theme="light"]) .hero__top .hero__year {
      -webkit-text-stroke-color: rgba(255, 255, 255, 0.07);
    }
    :global(html[data-theme="light"]) .hero__top .hero__crest-dark {
      display: block;
    }
    :global(html[data-theme="light"]) .hero__top .hero__crest-light {
      display: none;
    }
    :global(html[data-theme="light"]) .hero__team :global(.hero__img) {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 12%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 12%);
    }
    :global(html[data-theme="light"]) .hero__team::after {
      background: linear-gradient(transparent, #ffffff);
    }
  }

  /* Telefon w pionie i w poziomie: najpierw zdjęcie drużyny, pod nim tekst */
  @media (max-width: 700px), (orientation: landscape) and (max-height: 500px) {
    .hero__top {
      display: flex;
      flex-direction: column;
    }
    .hero__team {
      order: -1;
      margin: 0;
      z-index: 0;
    }
    .hero__year {
      display: none;
    }
    /* zdjęcie zaraz pod paskiem nawigacji: tło w tym samym ciemnym kolorze,
       bez jasnego pasa (także w jasnym motywie) */
    .hero__team {
      background: var(--black);
    }
    .hero__team :global(.hero__img),
    :global([data-theme]) .hero__team :global(.hero__img) {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__team::after {
      height: 22%;
      background: linear-gradient(transparent, var(--hero-bg));
    }
    .hero__in {
      align-items: flex-start;
      margin-top: -30px;
      padding-block: 0;
    }
    .hero__foot {
      padding-block: 14px 32px;
    }
    .hero__crest {
      display: none; /* herb jest już w pasku u góry */
    }
    .hero__text {
      padding-right: 0;
    }
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .hero__t1 {
      font-size: 64px;
    }
    .hero__t2 {
      font-size: 44px;
    }
    .hero__crest {
      display: block;
      width: 120px;
    }
  }

  /* Wejście hero: piorun uderza, tytuł wjeżdża */
  @media (prefers-reduced-motion: no-preference) {
    .hero__t1,
    .hero__t2,
    .hero__sub,
    .hero .btn-row,
    .hero__kicker {
      animation: hero-in 800ms var(--ease) both;
    }
    .hero__kicker { animation-delay: 250ms; }
    .hero__t1 { animation-delay: 320ms; }
    .hero__t2 { animation-delay: 420ms; }
    .hero__sub { animation-delay: 520ms; }
    .hero .btn-row { animation-delay: 620ms; }
    .hero__crest {
      animation: hero-crest 1000ms 300ms var(--ease) both;
    }
    .hero__team :global(.hero__img) {
      animation: hero-team 600ms var(--ease) both;
    }
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(40px) skewY(3deg); }
  }
  @keyframes hero-crest {
    from { opacity: 0; transform: scale(0.6) rotate(-25deg); }
  }
  @keyframes hero-team {
    from { opacity: 0; }
  }

  /* -- Najbliższy mecz ---------------------------------------- */
  .match {
    position: relative;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .match__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 6px solid var(--red);
    border-radius: var(--radius);
    padding: clamp(20px, 3vw, 32px);
  }
  .match__card--none {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .match__card--none .kicker {
    margin-bottom: 6px;
  }
  .match__text {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
  }
  .match__row {
    display: grid;
    gap: 16px;
    margin-bottom: 18px;
    font-family: var(--font-cond);
    text-transform: uppercase;
  }
  @media (min-width: 760px) {
    .match__row {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 32px;
    }
  }
  .match__when {
    display: flex;
    flex-direction: column;
    font-weight: 700;
  }
  .match__day {
    font-size: 18px;
    color: var(--muted);
  }
  .match__time {
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
  }
  .match__teams {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 800;
    line-height: 1;
  }
  .match__vs {
    font-size: 18px;
    color: var(--accent);
  }
  .match__where {
    font-weight: 600;
    font-size: 18px;
  }
  .match__tag {
    display: inline-block;
    margin-right: 8px;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--red);
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  /* -- Aktualności na starcie ------------------------------------ */
  .news-home__match {
    margin-bottom: 18px;
  }
  .news-home__league {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 18px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--border);
    border-left: 6px solid var(--red);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .news-home__league[hidden] {
    display: none;
  }
  .news-home__league .kicker {
    margin-bottom: 6px;
  }
  .news-home__text {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
  }
  .news-home__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  /* -- Szyna zawodników: przewijana na telefonie, siatka na monitorze */
  .rail {
    list-style: none;
    margin: 0;
    padding: 6px var(--gutter) 18px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 62vw);
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail > li {
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .rail {
      grid-auto-columns: minmax(240px, 38vw);
    }
  }
  @media (min-width: 1024px) {
    .rail {
      max-width: var(--wrap);
      margin-inline: auto;
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
      gap: 20px;
    }
  }

  /* -- Panele: sztab i akademia ----------------------------------- */
  .duo {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 860px) {
    .duo {
      grid-template-columns: 1fr 1fr;
    }
  }
  .panel {
    position: relative;
    display: block;
    min-height: 320px;
    padding: clamp(26px, 4vw, 48px);
    border-radius: var(--radius);
    color: #fff;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
  }
  .panel:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }
  .panel p {
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.86);
  }
  .panel .kicker {
    color: #fff;
  }
  .panel--red {
    background: linear-gradient(135deg, var(--red) 0%, #8e020d 100%);
  }
  .panel--dark {
    background: linear-gradient(135deg, #2a231e 0%, #0e0c09 100%);
  }
  .panel--dark .kicker {
    color: var(--red-on-dark);
  }
  .panel__cta {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 3px solid currentColor;
    padding-bottom: 2px;
  }

  /* -- Pas social media ------------------------------------------ */
  .social-band {
    position: relative;
    overflow: hidden;
  }
  .social-band::after {
    content: "";
    position: absolute;
    inset: auto -10% -60% 40%;
    height: 120%;
