---
/* Strona startowa (wspólna dla PL i EN). */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PlayerCard from "../components/PlayerCard.astro";
import StaffCard from "../components/StaffCard.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import { kibice } from "../data/marketing";
import Social from "../components/Social.astro";
import MatchCard from "../components/MatchCard.astro";
import NewsCard from "../components/NewsCard.astro";
import LastResult from "../components/LastResult.astro";
import herbCzerwony from "../assets/logo/herb-czerwony.png";
import { klub } from "../data/klub";
import { kolejnyMecz, najblizszyMecz } from "../lib/terminarz";
import { type Lang, ROUTES, route, t } from "../i18n/ui";
import { aktualnosci, sponsorzy as getSponsorzy, sztab as getSztab, zawodnicy as getZawodnicy } from "../lib/data";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const players = await getZawodnicy();
const staff = await getSztab();
const sponsors = await getSponsorzy();


/* Zdjęcie drużyny w hero — na razie brak (będzie nowe).
   Gdy przyjdzie: zapisz plik jako src/assets/start/druzyna.jpg,
   dodaj na górze  import druzyna from "../assets/start/druzyna.jpg";
   i zamień poniższe undefined na  druzyna  — pokaże się pod nazwą klubu. */
const zdjecieDruzyny: ImageMetadata | undefined = undefined;

const mecz = najblizszyMecz;
// Wpis o najbliższym meczu nie dubluje karty meczu — karta prowadzi do niego przyciskiem
const wszystkie = await aktualnosci();
// Zapowiedź najbliższego meczu nie dubluje karty meczu powyżej
// Grafika meczowa = zdjęcie we wpisie o danym meczu
const plakat = (d?: string) => (d ? wszystkie.find((w) => w.data.mecz?.data === d)?.data.zdjecie : undefined);
// Zapowiedź meczu, który już się odbył, znika z listy (wpis zostaje pod swoim adresem)
const polskaTeraz = new Date().toLocaleString("sv-SE", { timeZone: "Europe/Warsaw" }).replace(" ", "T").slice(0, 16);
const wpisy = wszystkie.filter((w) => !(mecz && w.data.mecz?.data === mecz.data) && !(w.data.mecz && w.data.mecz.data < polskaTeraz)).slice(0, 3);
---

<Base lang={lang} alt={{ pl: u(ROUTES.start.pl), en: u(ROUTES.start.en) }} active="start">
  <!-- ══════════════ HERO ══════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__year" aria-hidden="true">{klub.rokZalozenia}</div>
    <div class="hero__in wrap">
      <div class="hero__crest">
        <Image src={herbCzerwony} alt={lang === "pl" ? "Herb ŁKS Łódź" : "ŁKS Łódź crest"} width={320} height={321} loading="eager" fetchpriority="high" />
      </div>
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__t1">ŁKS</span>{" "}<span class="hero__t2">CoolPack <span class="nw">Łódź</span></span>
        </h1>
        <p class="hero__sub">{t(lang, "hero.sub")}</p>
      </div>
    </div>
    {
      zdjecieDruzyny && (
        <div class="hero__team wrap">
          <Image
            class="hero__img"
            src={zdjecieDruzyny}
            alt={lang === "pl" ? "Drużyna i sztab ŁKS CoolPack Łódź" : "ŁKS CoolPack Łódź players and staff"}
            widths={[800, 1200, 1600, 2400]}
            sizes="(min-width: 1280px) 1200px, 100vw"
            loading="eager"
          />
        </div>
      )
    }
  </section>

  <!-- ══════════════ AKTUALNOŚCI: najbliższy mecz + najnowsze wpisy ══════════════ -->
  <section class="section news-home" aria-labelledby="news-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "news.kicker")}</p>
          <h2 id="news-h" class="h-lg">{t(lang, "news.title")}</h2>
        </div>
      </div>
      {
        mecz && (
          <div class="news-home__match reveal">
            <MatchCard lang={lang} data={mecz.data} rywal={mecz.rywal} dom={mecz.dom} miejsce={mecz.hala} bilety={mecz.bilety} transmisja={mecz.transmisja} ics={mecz.ics} mapa={mecz.mapa} plakat={plakat(mecz.data)} />
          </div>
        )
      }
      {
        /* Zapas: gdy najbliższy mecz już się skończył, a terminarz nie jest jeszcze zaktualizowany */
        mecz && kolejnyMecz && (
          <div class="news-home__match" data-zapas hidden>
            <MatchCard lang={lang} data={kolejnyMecz.data} rywal={kolejnyMecz.rywal} dom={kolejnyMecz.dom} miejsce={kolejnyMecz.hala} bilety={kolejnyMecz.bilety} transmisja={kolejnyMecz.transmisja} ics={kolejnyMecz.ics} mapa={kolejnyMecz.mapa} plakat={plakat(kolejnyMecz.data)} />
          </div>
        )
      }
      <LastResult lang={lang} />
      <div class="news-home__league reveal" data-po-meczu hidden={mecz ? true : undefined}>
        <div>
          <p class="kicker">{t(lang, "match.none.title")}</p>
          <p class="news-home__text">{t(lang, "match.none.text")}</p>
        </div>
        <a class="btn" href={route("terminarz", lang)}>{t(lang, "match.none.cta")}</a>
      </div>
      {
        wpisy.length > 0 && (
          <ul class="news-home__list" role="list">
            {wpisy.map((w, i) => <li><NewsCard w={w} lang={lang} index={i} /></li>)}
          </ul>
        )
      }
    </div>
  </section>

  <!-- ══════════════ SKŁAD ══════════════ -->
  <section class="section" aria-labelledby="sklad-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "team.kicker")}</p>
          <h2 id="sklad-title" class="h-lg">{t(lang, "team.title")}</h2>
          <p class="lead">{t(lang, "team.lead")}</p>
        </div>
        <a class="btn btn--ghost" href={route("sklad", lang)}>{t(lang, "team.all")}</a>
      </div>
    </div>
    <ul class="rail" role="list">
      {players.map((p, i) => <li><PlayerCard p={p} lang={lang} index={i} /></li>)}
    </ul>

    <!-- Sztab w tej samej sekcji „Sezon 2026/2027” (zdjęcia jak w składzie, bez pioruna; klik → podstrona Sztab) -->
    <div class="wrap staff-head">
      <div class="section-head">
        <div>
          <h2 id="sztab-title" class="h-lg">{t(lang, "staff.title")}</h2>
          <p class="lead">{t(lang, "staff.lead")}</p>
        </div>
        <a class="btn btn--ghost" href={route("sztab", lang)}>{t(lang, "staff.cta")}</a>
      </div>
    </div>
    <ul class="rail rail--staff" role="list" aria-labelledby="sztab-title">
      {staff.map((s, i) => <li><StaffCard s={s} lang={lang} index={i} /></li>)}
    </ul>
  </section>

  <!-- ══════════════ PRZYJDŹ NA MECZ (dla kibiców) ══════════════ -->
  <section class="section" aria-labelledby="mecz-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{kibice.kicker[lang]}</p>
          <h2 id="mecz-title" class="h-lg">{kibice.tytul[lang]}</h2>
          <p class="lead">{kibice.lead[lang]}</p>
        </div>
      </div>
      <ul class="feats" role="list">
        {
          kibice.kafle.map((k, i) => (
            <li class="feat reveal" style={`--d:${i * 70}ms`}>
              <FeatureIcon name={k.ikona} />
              <h3 class="feat__h">{k.tytul[lang]}</h3>
              <p class="feat__t">{k.tekst[lang]}</p>
            </li>
          ))
        }
      </ul>
      <div class="card card--accent venue reveal">
        <div>
          <p class="kicker">{t(lang, "venue.kicker")}</p>
          <p class="venue__name">{klub.kontakt.hala.nazwa}</p>
          <p class="venue__addr">{klub.kontakt.hala.adres}</p>
          <p class="venue__note">{kibice.bilety[lang]}</p>
        </div>
        <div class="btn-row venue__btns">
          {mecz?.dom && mecz.bilety && <a class="btn" href={mecz.bilety} target="_blank" rel="noopener">{t(lang, "match.buyShort")}</a>}
          <a class:list={["btn", { "btn--ghost": mecz?.dom && mecz.bilety }]} href={klub.kontakt.hala.mapa} target="_blank" rel="noopener">{t(lang, "venue.map")}</a>
          <a class="btn btn--ghost" href={route("terminarz", lang)}>{t(lang, "venue.fixtures")}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ AKTUALNOŚCI / SOCIAL ══════════════ -->
  <section class="section social-band" aria-labelledby="news-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t(lang, "news.social")}</p>
          <h2 id="news-title" class="h-lg">{t(lang, "news.follow")}</h2>
          <p class="lead">{t(lang, "news.lead")}</p>
        </div>
      </div>
      <Social lang={lang} size="lg" />
    </div>
  </section>

  <!-- ══════════════ SPONSORZY ══════════════ -->
  {
    sponsors.length > 0 && (
      <section class="section sponsors-band" aria-labelledby="sp-title">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="kicker">{t(lang, "sponsors.kicker")}</p>
              <h2 id="sp-title" class="h-lg">{t(lang, "sponsors.title")}</h2>
            </div>
            <a class="btn btn--ghost" href={route("sponsorzy", lang)}>{t(lang, "sponsors.join.title")}</a>
          </div>
          <ul class="logos" role="list">
            {sponsors.map((s) => {
              const Tag = s.data.link ? "a" : "div";
              const linkProps = s.data.link ? { href: s.data.link, target: "_blank", rel: "noopener", "aria-label": s.data.nazwa } : {};
              return (
                <li class="reveal">
                  <Tag class="logos__tile" {...linkProps}>
                    {s.data.logo ? (
                      <>
                        <Image src={s.data.logo} alt={s.data.nazwa} height={56} />
                      </>
                    ) : (
                      <span class="logos__name">{s.data.nazwa}</span>
                    )}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* -- Hero ------------------------------------------------------
     Jasny, zwarty: herb klubu + nazwa, opis i przyciski.
     Miejsce na zdjęcie drużyny pod spodem (gdy będzie).            */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
    padding-block: clamp(28px, 5vw, 64px) clamp(20px, 3vw, 36px);
  }
  .hero__year {
    position: absolute;
    z-index: -1;
    right: -2vw;
    top: -1vw;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(130px, 26vw, 380px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgba(23, 20, 15, 0.06);
    user-select: none;
  }
  .hero__in {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(18px, 4vw, 56px);
  }
  .hero__crest {
    width: clamp(96px, 20vw, 240px);
  }
  .hero__crest :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero__title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.22em;
    line-height: 0.88;
  }
  .hero__t1 {
    font-size: clamp(56px, 9vw, 130px);
  }
  .hero__t2 {
    font-size: clamp(34px, 5.6vw, 82px);
    color: var(--red);
  }
  .hero__sub {
    max-width: 58ch;
    margin: clamp(12px, 1.6vw, 20px) 0 clamp(16px, 2vw, 24px);
    font-size: clamp(16px, 1.5vw, 19px);
    color: var(--muted);
  }
  .hero__team {
    margin-top: clamp(20px, 3vw, 36px);
  }
  .hero__team :global(.hero__img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  /* Telefon: herb obok nazwy, opis i przyciski pod spodem na całą szerokość */
  @media (max-width: 640px) {
    .hero__in {
      grid-template-columns: auto 1fr;
      gap: 6px 16px;
    }
    .hero__text {
      display: contents;
    }
    .hero__crest {
      width: 84px;
    }
    /* Pełna nazwa obok herbu: „ŁKS” nad „CoolPack Łódź”.
       Rozmiar „CoolPack Łódź” liczony od szerokości kolumny (cqi),
       więc napis zawsze mieści się w jednym wierszu — także na wąskich
       telefonach i przy powiększonej czcionce. */
    .hero__title {
      container-type: inline-size;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .hero__t1 {
      font-size: min(60px, 34cqi);
    }
    .hero__t2 {
      font-size: min(34px, 16cqi);
      letter-spacing: -0.005em;
      white-space: nowrap;
    }
    .hero__sub {
      grid-column: 1 / -1;
    }
    .hero__sub {
      margin-top: 14px;
    }
  }

  /* Wejście hero: herb się obraca, tytuł wjeżdża */
  @media (prefers-reduced-motion: no-preference) {
    .hero__t1,
    .hero__t2,
    .hero__sub {
      animation: hero-in 800ms var(--ease) both;
    }
    .hero__t1 { animation-delay: 200ms; }
    .hero__t2 { animation-delay: 300ms; }
    .hero__sub { animation-delay: 400ms; }
    .hero__crest {
      animation: hero-crest 900ms 100ms var(--ease) both;
    }
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(30px) skewY(2deg); }
  }
  @keyframes hero-crest {
    from { opacity: 0; transform: scale(0.6) rotate(-25deg); }
  }

  /* -- Najbliższy mecz ---------------------------------------- */
  .match {
    position: relative;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .match__text {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
  }
  .match__row {
    display: grid;
    gap: 16px;
    margin-bottom: 18px;
    font-family: var(--font-cond);
    text-transform: uppercase;
  }
  @media (min-width: 760px) {
    .match__row {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 32px;
    }
  }
  .match__when {
    display: flex;
    flex-direction: column;
    font-weight: 700;
  }
  .match__day {
    font-size: 18px;
    color: var(--muted);
  }
  .match__time {
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
  }
  .match__teams {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    font-size: clamp(26px, 3.4vw, 40px);
    font-weight: 800;
    line-height: 1;
  }
  .match__vs {
    font-size: 18px;
    color: var(--accent);
  }
  .match__where {
    font-weight: 600;
    font-size: 18px;
  }
  .match__tag {
    display: inline-block;
    margin-right: 8px;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--red);
    color: #fff;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  /* -- Aktualności na starcie ------------------------------------ */
  .news-home__match {
    margin-bottom: 18px;
  }
  .news-home__league {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 18px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--border);
    border-left: 5px solid var(--red);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .news-home__league[hidden] {
    display: none;
  }
  .news-home__league .kicker {
    margin-bottom: 6px;
  }
  .news-home__text {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
  }
  .news-home__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  /* -- Szyna zawodników: przewijana na telefonie, siatka na monitorze */
  .rail {
    list-style: none;
    margin: 0;
    padding: 6px var(--gutter) 18px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 62vw);
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail > li {
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .rail {
      grid-auto-columns: minmax(240px, 38vw);
    }
  }
  @media (min-width: 1024px) {
    .rail {
      max-width: var(--wrap);
      margin-inline: auto;
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
      gap: 20px;
    }
  }

  .staff-head {
    margin-top: clamp(28px, 4vw, 48px);
  }
  /* Sztab: 6 osób = 2 równe rzędy po 3 na monitorze */
  @media (min-width: 1024px) {
    .rail--staff {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* -- Przyjdź na mecz: kafle z argumentami + hala ---------------- */
  .feats {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  @media (max-width: 640px) {
    .feats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .feat {
      padding: 14px !important;
    }
    .feat__h {
      font-size: 18px !important;
      margin-top: 8px !important;
    }
    .feat__t {
      font-size: 13.5px !important;
      line-height: 1.45 !important;
    }
  }
  .feat {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .feat__h {
    margin: 12px 0 6px;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.1;
  }
  .feat__t {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
  .venue {
    display: grid;
    gap: 16px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .venue {
      grid-template-columns: 1fr auto;
    }
  }
  .venue__name {
    margin: 0;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.1;
    text-transform: uppercase;
  }
  .venue__addr {
    margin: 6px 0 0;
    font-weight: 600;
  }
  .venue__note {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  /* -- Logotypy sponsorów -------------------------------------- */
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* auto-fit: wszystkie logotypy w jednym równym rzędzie na monitorze, 2 kolumny na telefonie */
    grid-template-columns: repeat(auto-fit, minmax(min(150px, calc(50% - 6px)), 1fr));
    gap: 12px;
  }
  .logos__tile {
    text-decoration: none;
    display: grid;
    place-items: center;
    min-height: clamp(96px, 20vw, 120px);
    padding: clamp(14px, 3.5vw, 24px);
    border-radius: var(--radius);
    background: var(--bg-2);
    border: 1px solid var(--border);
    transition: border-color 200ms, transform 200ms;
  }
  .logos a:hover {
    border-color: var(--red);
    transform: translateY(-3px);
  }
  .logos :global(img) {
    max-height: 48px;
    max-width: 100%;
    width: auto;
  }
  .logos__name {
    text-align: center;
    line-height: 1.1;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(16px, 4.2vw, 24px);
    text-transform: uppercase;
    color: var(--text);
  }
</style>
