---
/* Pojedynczy wpis w Aktualnościach. */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import MatchCard from "../components/MatchCard.astro";
import NewsCard from "../components/NewsCard.astro";
import Social from "../components/Social.astro";
import { type Lang, newsUrl, route, t } from "../i18n/ui";
import { aktualnosci, dataWpisu, paragraphs, pick } from "../lib/data";

interface Props {
  lang: Lang;
  w: CollectionEntry<"aktualnosci">;
}
const { lang, w } = Astro.props;
const d = w.data;
const tytul = pick(d.tytul, d.tytulEn, lang);
const lead = pick(d.lead, d.leadEn, lang);
const tresc = paragraphs(pick(d.tresc, d.trescEn, lang));
const inne = (await aktualnosci()).filter((x) => x.id !== w.id).slice(0, 3);
---

<Base lang={lang} title={tytul} description={lead} alt={{ pl: newsUrl(w.id, "pl"), en: newsUrl(w.id, "en") }} active="aktualnosci" ogType="article">
  <article class="post">
    <header class="post__head">
      <div class="wrap post__wrap">
        <a class="post__back" href={route("aktualnosci", lang)}>← {t(lang, "news.back")}</a>
        <time class="post__date" datetime={d.data.toISOString().slice(0, 10)}>{dataWpisu(d.data, lang)}</time>
        <h1 class="post__title">{tytul}</h1>
        <p class="post__lead">{lead}</p>
      </div>
    </header>

    <div class="wrap post__wrap post__body">
      {d.zdjecie && <Image class="post__img" src={d.zdjecie} alt="" widths={[600, 900, 1400]} sizes="(min-width: 900px) 820px, 92vw" />}
      {d.mecz && <MatchCard lang={lang} data={d.mecz.data} rywal={d.mecz.rywal} dom={d.mecz.dom} miejsce={d.mecz.miejsce} kicker={t(lang, "news.match")} />}
      <div class="post__text">
        {tresc.map((p) => <p>{p}</p>)}
      </div>
      <div class="post__social">
        <Social lang={lang} size="lg" />
        <a class="btn btn--ghost" href={route("terminarz", lang)}>{t(lang, "match.none.cta")} →</a>
      </div>
    </div>
  </article>

  {
    inne.length > 0 && (
      <section class="section section--alt">
        <div class="wrap">
          <h2 class="h-md">{t(lang, "news.latest")}</h2>
          <ul class="post__more" role="list">
            {inne.map((x, i) => <li><NewsCard w={x} lang={lang} index={i} /></li>)}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .post__head {
    background:
      radial-gradient(70% 90% at 85% 0%, #3b0a0e 0%, transparent 60%),
      linear-gradient(180deg, #120f0c 0%, #0b0907 100%);
    color: #fff;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + clamp(28px, 6vw, 72px)) 0 clamp(32px, 5vw, 56px);
  }
  .post__wrap {
    max-width: 880px;
  }
  .post__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cfc6bc;
    text-decoration: none;
  }
  .post__back:hover {
    color: var(--red-on-dark);
  }
  .post__date {
    display: block;
    margin: 8px 0 10px;
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red-on-dark);
  }
  .post__title {
    font-size: clamp(34px, 6vw, 64px);
    line-height: 0.95;
    margin-bottom: 16px;
  }
  .post__lead {
    font-size: clamp(18px, 1.8vw, 21px);
    color: #ddd4ca;
    margin: 0;
  }
  .post__body {
    display: grid;
    gap: 24px;
    padding-block: clamp(28px, 5vw, 48px) clamp(48px, 7vw, 88px);
  }
  .post__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .post__text {
    font-size: clamp(17px, 1.5vw, 19px);
  }
  .post__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .post__more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
</style>
