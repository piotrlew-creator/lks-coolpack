---
/* Prywatność — krótka informacja w obu językach. */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { klub } from "../data/klub";
import { type Lang, ROUTES, t } from "../i18n/ui";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const email = klub.kontakt.biuro.email;
const stats = Boolean(klub.cfAnalyticsToken);
---

<Base lang={lang} title={t(lang, "privacy.title")} description={t(lang, "privacy.meta")} alt={{ pl: u(ROUTES.prywatnosc.pl), en: u(ROUTES.prywatnosc.en) }}>
  <PageHero title={t(lang, "privacy.title")} />
  <section class="section">
    <div class="wrap prose">
      {
        lang === "pl" ? (
          <>
            <h2>Bez plików cookies</h2>
            <p>Strona nie używa plików cookies, nic nie zapisuje w przeglądarce, nie ma formularzy i nie zbiera danych osobowych.</p>
            {stats && (
              <>
                <h2>Statystyki odwiedzin</h2>
                <p>
                  Odwiedziny liczymy anonimowo w Cloudflare Web Analytics, bez cookies i bez rozpoznawania
                  użytkowników. Widzimy tylko dane zbiorcze, np. liczbę odwiedzin i najczęściej oglądane strony.
                </p>
              </>
            )}
            {klub.facebookWtyczka && (
              <>
                <h2>Posty z Facebooka</h2>
                <p>
                  Posty z Facebooka wczytują się dopiero po kliknięciu „Pokaż posty”. Wtedy przeglądarka łączy się
                  z serwerami Meta, które mogą zapisać własne pliki cookies. Twój wybór zapamiętujemy w przeglądarce.
                </p>
              </>
            )}
            {klub.facebookWtyczka && (
              <>
                <h2>Pamięć przeglądarki</h2>
                <p>
                  W przeglądarce zapisujemy tylko zgodę na posty z Facebooka. Ta informacja do nas nie trafia. Usuniesz ją,
                  czyszcząc dane strony w ustawieniach przeglądarki.
                </p>
              </>
            )}
            <h2>Linki zewnętrzne</h2>
            <p>
              Odnośniki do Facebooka, Instagrama, X i strony ligi prowadzą do innych serwisów, które mają własne zasady
              prywatności.
            </p>
            {email && (
              <>
                <h2>Kontakt</h2>
                <p>
                  Pytania o prywatność: <a href={`mailto:${email}`}>{email}</a>
                </p>
              </>
            )}
          </>
        ) : (
          <>
            <h2>No cookies</h2>
            <p>This website doesn't use cookies, stores nothing in your browser, has no forms and doesn't collect personal data.</p>
            {stats && (
              <>
                <h2>Visitor statistics</h2>
                <p>
                  We count visits anonymously with Cloudflare Web Analytics, without cookies and without identifying
                  anyone. We only see totals, such as the number of visits and the most viewed pages.
                </p>
              </>
            )}
            {klub.facebookWtyczka && (
              <>
                <h2>Facebook posts</h2>
                <p>
                  Facebook posts only load after you click “Show posts”. Your browser then connects to Meta's servers,
                  which may set their own cookies. We remember your choice in your browser.
                </p>
              </>
            )}
            {klub.facebookWtyczka && (
              <>
                <h2>Browser storage</h2>
                <p>
                  We only store your consent to show Facebook posts in your browser. This isn't sent to us. You can remove
                  it by clearing this site's data in your browser settings.
                </p>
              </>
            )}
            <h2>External links</h2>
            <p>Links to Facebook, Instagram, X and the league website take you to other services with their own privacy policies.</p>
            {email && (
              <>
                <h2>Contact</h2>
                <p>
                  Privacy questions: <a href={`mailto:${email}`}>{email}</a>
                </p>
              </>
            )}
          </>
        )
      }
    </div>
  </section>
</Base>

<style>
  .prose {
    max-width: 760px;
  }
  .prose h2 {
    font-size: 28px;
    margin-top: 1.6em;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
</style>
