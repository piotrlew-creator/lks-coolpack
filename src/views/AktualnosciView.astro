---
/* Aktualności — Facebook i Instagram, ogłoszenia Klubu (gdy są), terminarz i tabela 1. ligi. */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import NewsCard from "../components/NewsCard.astro";
import { klub } from "../data/klub";
import { aktualnosci } from "../lib/data";
import { type Lang, ROUTES, route, t } from "../i18n/ui";
import { u } from "../lib/url";
import { kolejnyMecz, miejsceLks, najblizszyMecz } from "../lib/terminarz";
import MatchCard from "../components/MatchCard.astro";
import LeagueLogos from "../components/LeagueLogos.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const mecz = najblizszyMecz;
// Zapowiedź najbliższego meczu zastępuje karta meczu (z biletami, gdy jest link w src/data/klub.ts)
const wpisy = (await aktualnosci()).filter((w) => !(mecz && w.data.mecz?.data === mecz.data));
---

<Base lang={lang} title={t(lang, "news.title")} description={t(lang, "news.lead")} alt={{ pl: u(ROUTES.aktualnosci.pl), en: u(ROUTES.aktualnosci.en) }} active="aktualnosci">
  <PageHero kicker={t(lang, "news.kicker")} title={t(lang, "news.title")} lead={t(lang, "news.lead")} />

  {
    /* Ogłoszenia Klubu — pokazują się tylko, gdy w src/content/aktualnosci/ jest jakiś wpis */
    (mecz || wpisy.length > 0) && (
      <section class="section news-list-sec" aria-labelledby="ogl-h">
        <div class="wrap">
          <h2 id="ogl-h" class="h-md social-h">{t(lang, "news.notices")}</h2>
          {mecz && (
            <div class="news-home__match ogl-match">
              <MatchCard lang={lang} data={mecz.data} rywal={mecz.rywal} dom={mecz.dom} miejsce={mecz.hala} bilety={mecz.bilety} transmisja={mecz.transmisja} ics={mecz.ics} mapa={mecz.mapa} />
            </div>
          )}
          {mecz && kolejnyMecz && (
            <div class="news-home__match ogl-match" data-zapas hidden>
              <MatchCard lang={lang} data={kolejnyMecz.data} rywal={kolejnyMecz.rywal} dom={kolejnyMecz.dom} miejsce={kolejnyMecz.hala} bilety={kolejnyMecz.bilety} transmisja={kolejnyMecz.transmisja} ics={kolejnyMecz.ics} mapa={kolejnyMecz.mapa} />
            </div>
          )}
          {wpisy.length > 0 && (
            <ul class="news-list" role="list">
              {wpisy.map((w, i) => <li><NewsCard w={w} lang={lang} index={i} /></li>)}
            </ul>
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <h2 class="h-md social-h">{t(lang, "news.social")}</h2>
    </div>
    <div class="wrap news">
      {
        klub.facebookWtyczka ? (
      <div class="fb" data-href={klub.facebook} data-height="760" data-title={t(lang, "news.fb.title")}>
          <div class="fb__slot">
            <svg class="fb__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c-.02-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"></path></svg>
            <p class="fb__title">{t(lang, "news.fb.title")}</p>
            <p class="fb__desc">{t(lang, "news.fb.desc")}</p>
            <button type="button" class="btn fb__btn">{t(lang, "news.fb.btn")}</button>
            <p class="fb__note">{t(lang, "news.fb.note")}</p>
          </div>
          <p class="fb__fallback"><a href={klub.facebook} target="_blank" rel="noopener">{t(lang, "news.fb.open")} →</a></p>
        </div>
  
          ) : (
          <div class="news-cards">
            <a class="scard scard--fb" href={klub.facebook} target="_blank" rel="noopener">
              <svg class="scard__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c-.02-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"></path></svg>
              <span class="scard__name">Facebook</span>
              <span class="scard__handle">facebook.com/lkscoolpack</span>
              <span class="scard__text">{t(lang, "news.fb.card")}</span>
              <span class="scard__cta">{t(lang, "news.fb.open")} ↗</span>
            </a>
            {klub.instagram && (
              <a class="scard scard--ig" href={klub.instagram} target="_blank" rel="noopener">
                <svg class="scard__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"></path></svg>
                <span class="scard__name">Instagram</span>
                <span class="scard__text">{t(lang, "news.ig.card")}</span>
                <span class="scard__cta">{t(lang, "news.ig.open")} ↗</span>
              </a>
            )}
          </div>
        )
      }

      <aside class="news-side">
        <div class="card card--accent">
          <p class="kicker">{t(lang, "match.none.title")}</p>
          <p>{t(lang, "match.none.text")}</p>
          <a class="btn" href={route("terminarz", lang)}>{t(lang, "match.none.cta")} →</a>
        </div>
        <div class="card card--accent">
          <p class="kicker">{t(lang, "news.table")}</p>
          <div class="side-liga"><LeagueLogos height={40} tylko="1lm" /></div>
          {
            miejsceLks && (
              <p class="side-place">
                <strong>{miejsceLks.miejsce}.</strong>
                <span>
                  {t(lang, "last.place")} · {miejsceLks.bilans[0]}–{miejsceLks.bilans[1]} · {miejsceLks.pkt} {t(lang, "table.pts").toLowerCase()}
                </span>
              </p>
            )
          }
          <a class="btn btn--ghost" href={`${route("terminarz", lang)}#tabela`}>{t(lang, "last.table")} →</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .ogl-match {
    margin-bottom: 18px;
  }
  .news-list-sec {
    padding-top: clamp(32px, 5vw, 56px);
  }
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .social-h {
    margin-bottom: 22px;
  }
  .news-cards {
    display: grid;
    gap: 16px;
  }
  .scard {
    position: relative;
    display: grid;
    gap: 8px;
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 5px solid var(--red);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition: transform 200ms var(--ease), border-color 200ms var(--ease);
  }
  .scard:hover {
    transform: translateY(-3px);
    border-color: var(--red);
  }
  .scard__icon {
    width: 40px;
    height: 40px;
    fill: #1877f2;
  }
  .scard--ig .scard__icon {
    fill: #d62976;
  }
  .scard__name {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: clamp(32px, 5vw, 44px);
    text-transform: uppercase;
    line-height: 1;
  }
  .scard__handle {
    font-size: 15px;
    color: var(--muted);
  }
  .scard__text {
    font-size: 17px;
    max-width: 40ch;
  }
  .scard__cta {
    margin-top: 6px;
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
  }
  .news-social {
    margin-top: 28px;
  }
  .news-soon {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .news {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .news {
      grid-template-columns: minmax(0, 520px) 1fr;
      gap: 48px;
    }
    .news-side {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .news-side {
    display: grid;
    gap: 16px;
  }
  .news-side p:not(.kicker) {
    margin: 0 0 16px;
  }
  .side-liga {
    margin-bottom: 12px;
  }
  .side-place {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .side-place strong {
    font-family: var(--font-cond);
    font-weight: 800;
    font-size: 48px;
    line-height: 1;
    color: var(--red);
  }
  .side-place span {
    color: var(--muted);
  }
</style>
