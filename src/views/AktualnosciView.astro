---
/* Aktualności — posty z Facebooka (po zgodzie) i odnośniki do social mediów. */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Social from "../components/Social.astro";
import { klub } from "../data/klub";
import { type Lang, ROUTES, t } from "../i18n/ui";
import { u } from "../lib/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang} title={t(lang, "news.title")} description={t(lang, "news.lead")} alt={{ pl: u(ROUTES.aktualnosci.pl), en: u(ROUTES.aktualnosci.en) }} active="aktualnosci">
  <PageHero kicker={t(lang, "news.kicker")} title={t(lang, "news.title")} lead={t(lang, "news.lead")}>
    <div class="news-social">
      <Social lang={lang} size="lg" />
      {!klub.instagram && <p class="news-soon">{t(lang, "news.ig.soon")}</p>}
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap news">
      <div class="fb" data-href={klub.facebook} data-height="760" data-title={t(lang, "news.fb.title")}>
        <div class="fb__slot">
          <svg class="fb__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c-.02-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"></path></svg>
          <p class="fb__title">{t(lang, "news.fb.title")}</p>
          <p class="fb__desc">{t(lang, "news.fb.desc")}</p>
          <button type="button" class="btn fb__btn">{t(lang, "news.fb.btn")}</button>
          <p class="fb__note">{t(lang, "news.fb.note")}</p>
        </div>
        <p class="fb__fallback"><a href={klub.facebook} target="_blank" rel="noopener">{t(lang, "news.fb.open")} →</a></p>
      </div>

      <aside class="news-side">
        <div class="card">
          <p class="kicker">{t(lang, "match.none.title")}</p>
          <p>{t(lang, "match.none.text")}</p>
          <a class="btn" href={klub.stronaLigi} target="_blank" rel="noopener">{t(lang, "match.none.cta")} ↗</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .news-social {
    margin-top: 28px;
    color: #fff;
  }
  .news-soon {
    margin: 12px 0 0;
    font-size: 15px;
    color: #a0968c;
  }
  .news {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .news {
      grid-template-columns: minmax(0, 520px) 1fr;
      gap: 48px;
    }
    .news-side {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>
